<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 keeps MatchSim consumable by Unity 6 LTS Mono runtime
         AND by modern .NET test/build hosts. Pure-C# only; zero UnityEngine
         references per TECH_APPROACH.md §3.1 + design/modding.md §6
         Contracts/impl asmdef-split posture. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>FinalWhistle.MatchSim</RootNamespace>
    <AssemblyName>FinalWhistle.MatchSim</AssemblyName>
    <ProductName>Final Whistle MatchSim</ProductName>
    <Description>Pure-C# canonical match simulation. Q32.32 fixed-point determinism. Zero UnityEngine references per TECH_APPROACH.md §3.</Description>

    <!-- Deterministic build per `scripts/fw build-unity-plugins` SPEC 2026-04-29
         decisions-log §6 idempotency claim. Default Roslyn behavior embeds a
         build-timestamp + non-deterministic MVID into the PE header of the
         output DLL, which makes byte-equivalent recompilations produce
         byte-different binaries — and that breaks the "idempotent re-run = no
         git churn" promise of the DLL-drop strategy. With Deterministic=true,
         the compiler emits an MVID derived from a stable hash of source +
         resources + references. Same source ⇒ same DLL bytes ⇒ no churn.

         Required for the consumption-strategy contract: every committed DLL
         under `unity-project/Assets/Plugins/MatchSim/` must round-trip cleanly
         through `dotnet publish` without producing a diff. Phase-4 freshness
         check (deferred per SPEC decisions log §6) becomes trivially correct
         with this property in place. -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FinalWhistle.MatchSim.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- YamlDotNet for behavior-tree archetype loading per CLAUDE.md tech
         stack ("YAML for behavior-tree archetypes"). netstandard2.0-compatible
         and Unity-friendly. The two Month-3 archetype YAMLs (direct-pressing,
         low-block-counter) are embedded as resources below. -->
    <PackageReference Include="YamlDotNet" Version="17.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content/archetypes/*.yaml" />
  </ItemGroup>

</Project>
