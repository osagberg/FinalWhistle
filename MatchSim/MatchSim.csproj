<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 keeps MatchSim consumable by Unity 6 LTS Mono runtime
         AND by modern .NET test/build hosts. Pure-C# only; zero UnityEngine
         references per TECH_APPROACH.md §3.1 + design/modding.md §6
         Contracts/impl asmdef-split posture. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>FinalWhistle.MatchSim</RootNamespace>
    <AssemblyName>FinalWhistle.MatchSim</AssemblyName>
    <ProductName>Final Whistle MatchSim</ProductName>
    <Description>Pure-C# canonical match simulation. Q32.32 fixed-point determinism. Zero UnityEngine references per TECH_APPROACH.md §3.</Description>

    <!-- Reproducible build per `scripts/fw build-unity-plugins` SPEC 2026-04-29
         decisions-log §6 idempotency claim. The canonical .NET reproducible-
         builds recipe is two MSBuild properties working together:

           Deterministic=true              — Roslyn emits MVID from a stable
                                             hash of source + resources +
                                             references, not a timestamp.
                                             Fixes intra-machine churn.

           ContinuousIntegrationBuild=true — paths embedded in the PDB (and in
                                             debug-info-bearing portions of the
                                             PE header) are normalized via
                                             PathMap-style canonicalization.
                                             Fixes cross-machine churn —
                                             without this, my machine's
                                             /Users/vibelogic/dev/football/...
                                             paths differ from CI's
                                             /github/workspace/... paths,
                                             producing different SHA256 even
                                             when source is identical.

         Without ContinuousIntegrationBuild=true, b8bff55 fixed the local-
         rebuild churn case but Codex's verification on a different machine
         still produced a different SHA256 (P1 finding 2026-04-29).

         Trade-off accepted: local devs lose absolute-path navigation from
         compiled-DLL stack traces (paths show as /_/MatchSim/... rather than
         /Users/.../MatchSim/...). For Final Whistle that's fine — debugging
         happens against MatchSim source, not against the consumed-by-Unity
         DLL. The reproducibility win (committed DLLs round-trip cleanly
         from any machine + ANY future fresh-clone CI check is trivially
         correct) outweighs the minor IDE convenience. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FinalWhistle.MatchSim.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- YamlDotNet for behavior-tree archetype loading per CLAUDE.md tech
         stack ("YAML for behavior-tree archetypes"). netstandard2.0-compatible
         and Unity-friendly. The two Month-3 archetype YAMLs (direct-pressing,
         low-block-counter) are embedded as resources below. -->
    <PackageReference Include="YamlDotNet" Version="17.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content/archetypes/*.yaml" />
  </ItemGroup>

</Project>
