<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 keeps MatchSim consumable by Unity 6 LTS Mono runtime
         AND by modern .NET test/build hosts. Pure-C# only; zero UnityEngine
         references per TECH_APPROACH.md §3.1 + design/modding.md §6
         Contracts/impl asmdef-split posture. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>FinalWhistle.MatchSim</RootNamespace>
    <AssemblyName>FinalWhistle.MatchSim</AssemblyName>
    <ProductName>Final Whistle MatchSim</ProductName>
    <Description>Pure-C# canonical match simulation. Q32.32 fixed-point determinism. Zero UnityEngine references per TECH_APPROACH.md §3.</Description>

    <!-- Reproducible build per `scripts/fw build-unity-plugins` SPEC 2026-04-29
         decisions-log §6 idempotency claim. Three properties working together
         to produce bit-identical DLL/PDB outputs across machines + git
         commits + working-directory paths:

           Deterministic=true   — Roslyn emits MVID from a stable hash of
                                  source + resources + references, not a
                                  build timestamp. Fixes intra-machine
                                  rebuild churn.

           PathMap=...          — Compiler-level path remapping. Embedded
                                  source paths show as `/_/MatchSim/...`
                                  not `/Users/.../MatchSim/...`. Fixes
                                  cross-machine path-prefix churn.

           SourceControlInformationFeatureSupported=false
                                — Disables the SDK's git-HEAD-SHA +
                                  remote-URL extraction pipeline that
                                  would otherwise embed the current
                                  commit SHA into the PDB's sourcelink.json
                                  payload. Without this, every commit
                                  produces different PDB bytes even when
                                  source is identical, because the embedded
                                  SHA references the "to-be-committed"
                                  commit (a chicken-and-egg by definition:
                                  the build can't know its own commit SHA
                                  until after the commit lands).

         Earlier iterations:
           caa278f — original ship; non-deterministic MVID → daily churn
           b8bff55 — Deterministic=true → fixed same-machine MVID churn
           ea9fd56 — +ContinuousIntegrationBuild=true → fixed paths but
                     pulled in SDK-level Source Link auto-generation as
                     a side-effect. Source Link embedded the git HEAD
                     SHA into the PDB, producing per-commit drift Codex
                     caught (P1 round-3, 2026-04-29).
           THIS  — replace ContinuousIntegrationBuild with the more
                   surgical PathMap + SourceControl-disable pair.
                   Same path-normalization win, no git-SHA stamping.

         EmbedUntrackedSources=false belt-and-suspenders: even if some
         downstream pipeline reactivates Source Link, untracked-file
         embedding stays off, so a dirty working tree can't sneak
         build-machine-specific source bytes into the PDB.

         Trade-off accepted: PDB stack traces show `/_/MatchSim/...`
         paths instead of absolute. Local IDE debugging still works
         because debugger resolves source via the side-by-side
         convention (PDB next to DLL → IDE walks up to find source).
         The reproducibility win (committed DLLs round-trip cleanly
         from any machine + any commit + ANY future fresh-clone CI
         check trivially correct) outweighs the IDE convenience. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/MatchSim</PathMap>
    <SourceControlInformationFeatureSupported>false</SourceControlInformationFeatureSupported>
    <EnableSourceLink>false</EnableSourceLink>
    <SuppressImplicitSourceLink>true</SuppressImplicitSourceLink>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FinalWhistle.MatchSim.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- YamlDotNet for behavior-tree archetype loading per CLAUDE.md tech
         stack ("YAML for behavior-tree archetypes"). netstandard2.0-compatible
         and Unity-friendly. The two Month-3 archetype YAMLs (direct-pressing,
         low-block-counter) are embedded as resources below. -->
    <PackageReference Include="YamlDotNet" Version="17.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content/archetypes/*.yaml" />
  </ItemGroup>

</Project>
