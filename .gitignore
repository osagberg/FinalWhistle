# ==========================================
# Unity project
# ==========================================
unity-project/Library/
unity-project/Temp/
unity-project/Obj/
unity-project/Build/
unity-project/Builds/
unity-project/Logs/
unity-project/MemoryCaptures/
unity-project/UserSettings/

# Unity-generated metadata that shouldn't be committed
unity-project/*.csproj
unity-project/*.sln
unity-project/*.suo
unity-project/*.tmp
unity-project/*.user
unity-project/*.userprefs
unity-project/*.pidb
unity-project/*.booproj
unity-project/*.svd
unity-project/*.pdb
unity-project/*.mdb
unity-project/*.opendb
unity-project/*.VC.db

# Unity crash reports
unity-project/sysinfo.txt
unity-project/crashlytics-build.properties

# Rider / VS artifacts
.idea/
.vs/
.vscode/
*.DotSettings.user

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
# `Icon?` above is meant to match the macOS Finder resource fork file
# (literally "Icon" followed by \r). On the case-insensitive macOS APFS
# filesystem it also matches `icons` directory names, which is wrong —
# we have a real `src-tauri/icons/` directory the Tauri build needs.
# Explicit unignore below restores that path.
!src-tauri/icons/
!src-tauri/icons/**

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# Vendor — explicitly NOT ignored
# ==========================================
# Vendor-pinned installers stay in git
!unity-project/Vendor/
!unity-project/Vendor/**/*

# ==========================================
# Generated content — ignored
# ==========================================
content/probe/
content/screenshots/cache/
content/voice_cache/

# ==========================================
# Secrets
# ==========================================
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
credentials.json
secrets.json

# Steamworks / platform builds — tracked separately
steamworks/sdk/
!steamworks/config/

# ==========================================
# Build outputs
# ==========================================
*.zip
*.tar.gz
*.dmg
*.pkg
*.msi
*.exe.bak

# ==========================================
# Temp / logs
# ==========================================
*.log
*.tmp
*.swp
*.swo
*~
/tmp/

# ==========================================
# .NET / C# build artifacts (MatchSim + tests)
# ==========================================
**/bin/
**/obj/
*.user
*.userosscache
*.sln.docstates
*.suo
.vs/

# ==========================================
# Claude Code project state (opt-in: most of these stay)
# ==========================================
# Session-local transcripts — usually want these
# .claude/sessions/
# (uncomment if you want to exclude)

# Pre-compact hook auto-generates snapshots here; ephemera, not source
.claude/session-snapshots/

# ScheduleWakeup transient lockfile (per-session state, not source)
.claude/scheduled_tasks.lock

# ==========================================
# Agent / skill ports (not yet deliberately ported — contain absolute
# blueprint paths + claude-mcp references; revisit when porting is
# deliberate). Remove this line when porting happens.
# ==========================================
.agents/
