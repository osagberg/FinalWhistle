{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Final Whistle",
  "version": "0.1.0",
  "identifier": "com.vibelogic.finalwhistle",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter ./frontend dev",
    "beforeBuildCommand": "pnpm --filter ./frontend build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Final Whistle",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "theme": "auto"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; media-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "A procedural-fantasy football manager where careers remember.",
    "longDescription": "Final Whistle is a deep football management simulation with RPG-depth career memory, set in a procedurally generated fantasy football world. Every save is a different world; the kid you cut becomes another club's captain four seasons later.",
    "copyright": "Copyright (c) 2026 Vibelogic",
    "publisher": "Vibelogic",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
