#!/usr/bin/env bash
# agent-bus — append-only JSONL dialog CLI for Claude/Codex/user collaboration.
#
# Usage: agent-bus <subcommand> [args...]
# Subcommands: post | claim | read | list | help | version
#
# Env: AGENT_BUS_AUTHOR = claude | codex | user (default: user)
#      AGENT_BUS_DIR    = path to dialog dir (default: ./dialog)
#
# Exit codes:
#   0  success
#   1  generic failure (file IO, internal)
#   2  validation error (bad input from caller)
#   3  not found (topic missing on read)
#   4  closed-topic write warning (still writes; advisory)
#
# See docs/tooling/agent-bus-spec.md for the protocol.

set -euo pipefail

VERSION="0.2.0"
DIALOG_DIR="${AGENT_BUS_DIR:-dialog}"
AUTHOR="${AGENT_BUS_AUTHOR:-user}"
MAX_BODY_BYTES=4096

# ---------- utilities ----------

die() { printf 'agent-bus: error: %s\n' "$1" >&2; exit "${2:-1}"; }
warn() { printf 'agent-bus: warning: %s\n' "$1" >&2; }

# jq is REQUIRED — silent-failure-hunter 2026-05-09 audit identified jq/awk
# json_escape inconsistency (trailing-newline drop on awk path; locale-dependent
# multi-byte handling on gawk) as a P0: same logical body would produce
# different sha256 hashes across hosts, breaking in_reply_to linkage.
# jq is in CLAUDE.md/TOOLING.md baseline (`brew install jq` on macOS; pre-installed
# on most Linux distros). Failing fast at startup beats silent corruption.
require_jq() {
    if ! command -v jq >/dev/null 2>&1; then
        die "jq is required (install via 'brew install jq' on macOS, 'apt install jq' on Linux). Reason: cross-host sha256 stability for in_reply_to linkage; awk-based JSON escaping diverges on trailing newlines + multi-byte UTF-8 + gawk locales." 1
    fi
}

have_shasum() { command -v shasum >/dev/null 2>&1; }
have_sha256sum() { command -v sha256sum >/dev/null 2>&1; }

sha256_hex() {
    if have_sha256sum; then
        printf '%s' "$1" | sha256sum | awk '{print $1}'
    elif have_shasum; then
        printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
    else
        die "neither sha256sum nor shasum found; install one" 1
    fi
}

now_iso_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# JSON-string-escape stdin (raw -> safe JSON string contents, no surrounding quotes).
# Uses jq -Rs (jq is required; see require_jq).
json_escape() {
    local out
    out="$(printf '%s' "$1" | jq -Rs .)"
    # Strip surrounding quotes that jq adds. The output is the JSON-string
    # form of the input, with one trailing newline added by jq -Rs that we
    # need to preserve as part of the encoded string.
    printf '%s' "${out:1:${#out}-2}"
}

# ---------- validation ----------

valid_enum() {
    local val="$1"; shift
    for opt in "$@"; do
        [ "$val" = "$opt" ] && return 0
    done
    return 1
}

valid_topic() {
    [[ "$1" =~ ^[a-z0-9-]+$ ]]
}

valid_iso() {
    [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]
}

valid_sha256() {
    [[ "$1" =~ ^[0-9a-f]{64}$ ]]
}

# ---------- canonical encoding ----------

# Build canonical JSON line in fixed key order:
# time, from, to, topic, type, severity, body, links, in_reply_to.
canonical_line() {
    local time="$1" from="$2" to="$3" topic="$4" type="$5"
    local severity="$6" body="$7" links_csv="$8" in_reply_to="$9"

    local body_esc; body_esc="$(json_escape "$body")"
    local sev_field
    if [ -z "$severity" ]; then sev_field='null'; else sev_field='"'"$severity"'"'; fi

    local links_field='null'
    if [ -n "$links_csv" ]; then
        local IFS=','
        # shellcheck disable=SC2206
        local arr=($links_csv)
        local out=''
        local first=1
        local item
        for item in "${arr[@]}"; do
            local trimmed="${item## }"; trimmed="${trimmed%% }"
            [ -z "$trimmed" ] && continue
            local esc; esc="$(json_escape "$trimmed")"
            if [ $first -eq 1 ]; then out='"'"$esc"'"'; first=0
            else out="$out"',"'"$esc"'"'
            fi
        done
        if [ -n "$out" ]; then links_field='['"$out"']'; fi
    fi

    local irt_field='null'
    if [ -n "$in_reply_to" ]; then irt_field='"'"$in_reply_to"'"'; fi

    printf '{"time":"%s","from":"%s","to":"%s","topic":"%s","type":"%s","severity":%s,"body":"%s","links":%s,"in_reply_to":%s}' \
        "$time" "$from" "$to" "$topic" "$type" "$sev_field" "$body_esc" "$links_field" "$irt_field"
}

# ---------- core operations ----------

cmd_post() {
    local topic='' type='' severity='' body='' in_reply_to='' links_csv='' to='all' from="$AUTHOR"

    while [ $# -gt 0 ]; do
        case "$1" in
            --topic) topic="${2:-}"; shift 2 ;;
            --type) type="${2:-}"; shift 2 ;;
            --severity) severity="${2:-}"; shift 2 ;;
            --body) body="${2:-}"; shift 2 ;;
            --in-reply-to) in_reply_to="${2:-}"; shift 2 ;;
            --links) links_csv="${2:-}"; shift 2 ;;
            --to) to="${2:-}"; shift 2 ;;
            --from) from="${2:-}"; shift 2 ;;
            *) die "unknown post flag: $1" 2 ;;
        esac
    done

    [ -n "$topic" ] || die "--topic required" 2
    [ -n "$type" ]  || die "--type required" 2
    [ -n "$body" ]  || die "--body required (non-empty)" 2

    valid_topic "$topic" || die "topic must match ^[a-z0-9-]+$ (got: $topic)" 2
    valid_enum "$from" claude codex user || die "--from must be claude|codex|user (got: $from)" 2
    valid_enum "$to" claude codex user all || die "--to must be claude|codex|user|all (got: $to)" 2
    valid_enum "$type" claim counter evidence question decision ack note task-spec escalation task-complete \
        || die "--type must be one of: claim counter evidence question decision ack note task-spec escalation task-complete (got: $type)" 2

    case "$type" in
        claim|counter|evidence|escalation)
            [ -n "$severity" ] || die "severity required for type=$type" 2
            valid_enum "$severity" p0 p1 p2 p3 || die "severity must be p0|p1|p2|p3 (got: $severity)" 2
            ;;
        note|ack|task-complete)
            if [ -n "$severity" ]; then
                die "severity must be null/empty for type=$type" 2
            fi
            ;;
        question|decision|task-spec)
            if [ -n "$severity" ]; then
                valid_enum "$severity" p0 p1 p2 p3 || die "severity must be p0|p1|p2|p3 if set (got: $severity)" 2
            fi
            ;;
    esac

    # Tier-2 v0.2.0 author-only checks (post-validation; cheap to enforce here).
    case "$type" in
        task-spec)
            [ "$from" = "user" ] || die "type=task-spec MUST be from=user (got from=$from); agents cannot self-issue task specs per spec §15" 2
            ;;
        task-complete)
            valid_enum "$from" claude codex || die "type=task-complete must be from=claude or from=codex (got: $from); user does not post task-complete events" 2
            ;;
    esac

    local blen; blen="$(printf '%s' "$body" | wc -c | tr -d ' ')"
    if [ "$blen" -gt "$MAX_BODY_BYTES" ]; then
        die "body length $blen exceeds cap of $MAX_BODY_BYTES bytes; split into multiple events or trim" 2
    fi

    if [ -n "$in_reply_to" ]; then
        valid_sha256 "$in_reply_to" || die "--in-reply-to must be 64-hex sha256 (got: $in_reply_to)" 2
    fi

    mkdir -p "$DIALOG_DIR" || die "cannot create $DIALOG_DIR" 1
    local file="$DIALOG_DIR/$topic.jsonl"
    local time; time="$(now_iso_utc)"

    # Enforce per-topic caps per spec §13. Env-var-driven; absent = no cap.
    # Pass the candidate body bytes + the resolved --from so the cap check
    # is correct under --from overrides (per Codex 2026-05-11 P1 fix).
    local candidate_body_bytes
    candidate_body_bytes="$(printf '%s' "$body" | wc -c | tr -d ' ')"
    enforce_caps "$topic" "$candidate_body_bytes" "$from"

    # Closure detection: parse each line as JSON via jq instead of grep regex
    # (silent-failure-hunter P1 — grep regex had false-positive cases on bodies
    # containing literal "from":"user","type":"decision" substring).
    if [ -f "$file" ]; then
        if jq -se 'any(.[]; .from == "user" and .type == "decision")' "$file" 2>/dev/null | grep -q '^true$'; then
            warn "topic '$topic' is closed (user decision present); appending advisory event"
        fi
    fi

    local line; line="$(canonical_line "$time" "$from" "$to" "$topic" "$type" "$severity" "$body" "$links_csv" "$in_reply_to")"

    # jq is required (see require_jq); validate the generated line is parseable.
    printf '%s' "$line" | jq -e . >/dev/null 2>&1 \
        || die "internal: generated line is not valid JSON; please file a bug" 1

    local tmp; tmp="$(mktemp "${file}.XXXXXX")"
    if [ -f "$file" ]; then cat "$file" > "$tmp"; fi
    printf '%s\n' "$line" >> "$tmp"
    mv "$tmp" "$file"

    sha256_hex "$line"
}

cmd_claim() {
    cmd_post --type claim "$@"
}

cmd_read() {
    local topic='' since='' filter_from='' filter_type='' filter_severity=''
    while [ $# -gt 0 ]; do
        case "$1" in
            --topic) topic="${2:-}"; shift 2 ;;
            --since) since="${2:-}"; shift 2 ;;
            --from) filter_from="${2:-}"; shift 2 ;;
            --type) filter_type="${2:-}"; shift 2 ;;
            --severity) filter_severity="${2:-}"; shift 2 ;;
            *) die "unknown read flag: $1" 2 ;;
        esac
    done
    [ -n "$topic" ] || die "--topic required" 2
    valid_topic "$topic" || die "invalid topic" 2
    if [ -n "$since" ]; then valid_iso "$since" || die "--since must be ISO 8601 UTC (e.g. 2026-05-08T00:00:00Z)" 2; fi

    local file="$DIALOG_DIR/$topic.jsonl"
    [ -f "$file" ] || die "topic not found: $topic" 3

    local line lineno=0
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        [ -z "$line" ] && continue

        # Parse-or-skip per silent-failure-hunter P1 — a malformed line must
        # not abort the read of subsequent valid lines (worst failure mode for
        # an audit-trail tool). Validate with jq -e first; warn + continue on
        # parse error.
        local parsed
        if ! parsed="$(printf '%s' "$line" | jq -ce . 2>/dev/null)"; then
            warn "skipping malformed line $lineno in $file (not valid JSON)"
            continue
        fi

        local t f ty sev to body
        t="$(printf '%s' "$parsed" | jq -r '.time // ""')"
        f="$(printf '%s' "$parsed" | jq -r '.from // ""')"
        ty="$(printf '%s' "$parsed" | jq -r '.type // ""')"
        sev="$(printf '%s' "$parsed" | jq -r '.severity // ""')"
        to="$(printf '%s' "$parsed" | jq -r '.to // ""')"
        body="$(printf '%s' "$parsed" | jq -r '.body // ""')"

        [ -n "$since" ] && [ -n "$t" ] && [ "$t" \< "$since" ] && continue
        [ -n "$filter_from" ] && [ "$f" != "$filter_from" ] && continue
        [ -n "$filter_type" ] && [ "$ty" != "$filter_type" ] && continue
        [ -n "$filter_severity" ] && [ "$sev" != "$filter_severity" ] && continue

        local sev_disp; sev_disp="${sev:--}"
        printf '%s  %-6s -> %-6s  %-8s  [%s]\n' "$t" "$f" "$to" "$ty" "$sev_disp"
        printf '  %s\n\n' "${body//$'\n'/$'\n  '}"
    done < "$file"
}

cmd_list() {
    local mode='all'
    while [ $# -gt 0 ]; do
        case "$1" in
            --open) mode='open'; shift ;;
            --closed) mode='closed'; shift ;;
            --all) mode='all'; shift ;;
            *) die "unknown list flag: $1" 2 ;;
        esac
    done

    [ -d "$DIALOG_DIR" ] || { printf '(no dialog directory at %s)\n' "$DIALOG_DIR"; return 0; }

    local f topic status n_events
    local found=0
    for f in "$DIALOG_DIR"/*.jsonl; do
        [ -f "$f" ] || continue
        found=1
        topic="$(basename "$f" .jsonl)"
        # Closure detection via jq parser (silent-failure-hunter P1 fix).
        if jq -se 'any(.[]; .from == "user" and .type == "decision")' "$f" 2>/dev/null | grep -q '^true$'; then
            status='closed'
        else
            status='open'
        fi
        case "$mode" in
            open)   [ "$status" = 'open' ]   || continue ;;
            closed) [ "$status" = 'closed' ] || continue ;;
        esac
        n_events="$(wc -l < "$f" | tr -d ' ')"
        printf '%-8s  %4s events  %s\n' "$status" "$n_events" "$topic"
    done
    # Explicit return 0 — silent-failure-hunter 2026-05-09 P3 fix:
    # the prior `[ $found -eq 0 ] && printf ...` short-circuit returned
    # exit 1 when found=1 (printf not run), tripping `set -e` at end-of-fn.
    if [ $found -eq 0 ]; then
        printf '(no topics in %s)\n' "$DIALOG_DIR"
    fi
    return 0
}

cmd_archive() {
    local age_days=30
    local dry_run=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --age-days) age_days="${2:-}"; shift 2 ;;
            --dry-run) dry_run=1; shift ;;
            *) die "unknown archive flag: $1" 2 ;;
        esac
    done

    [ -d "$DIALOG_DIR" ] || { printf '(no dialog directory at %s)\n' "$DIALOG_DIR"; return 0; }

    # Strict-positive integer for --age-days.
    case "$age_days" in
        ''|*[!0-9]*) die "--age-days must be a non-negative integer (got: $age_days)" 2 ;;
    esac

    local archive_root="$DIALOG_DIR/archive"
    local f topic last_event_iso ym dest archived=0
    local now_epoch; now_epoch="$(date -u +%s)"
    local cutoff_epoch=$((now_epoch - age_days * 86400))

    for f in "$DIALOG_DIR"/*.jsonl; do
        [ -f "$f" ] || continue
        topic="$(basename "$f" .jsonl)"

        # Closed only — never archive open topics.
        if ! jq -se 'any(.[]; .from == "user" and .type == "decision")' "$f" 2>/dev/null | grep -q '^true$'; then
            continue
        fi

        # Use the most recent event's `time` field as the topic's age.
        last_event_iso="$(tail -n1 "$f" | jq -r '.time // ""' 2>/dev/null || true)"
        if [ -z "$last_event_iso" ]; then
            warn "skipping $topic: cannot read last-event time"
            continue
        fi

        # Convert ISO to epoch (BSD vs GNU date — BSD on macOS needs -j -f).
        local last_epoch=''
        if last_epoch="$(date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$last_event_iso" +%s 2>/dev/null)"; then
            :  # macOS BSD path succeeded
        elif last_epoch="$(date -u -d "$last_event_iso" +%s 2>/dev/null)"; then
            :  # GNU coreutils path succeeded
        else
            warn "skipping $topic: cannot parse ISO time '$last_event_iso'"
            continue
        fi

        if [ "$last_epoch" -ge "$cutoff_epoch" ]; then
            continue   # too recent
        fi

        ym="$(printf '%s' "$last_event_iso" | cut -c1-7)"   # YYYY-MM
        dest="$archive_root/$ym"

        if [ "$dry_run" -eq 1 ]; then
            printf 'would archive: %-50s -> %s/\n' "$topic" "$dest"
        else
            mkdir -p "$dest"
            mv "$f" "$dest/"
            printf 'archived: %-50s -> %s/\n' "$topic" "$dest"
        fi
        archived=$((archived + 1))
    done

    if [ "$archived" -eq 0 ]; then
        printf '(no closed topics older than %s days to archive)\n' "$age_days"
    fi
    return 0
}

cmd_stats() {
    local topic_filter=''
    while [ $# -gt 0 ]; do
        case "$1" in
            --topic) topic_filter="${2:-}"; shift 2 ;;
            *) die "unknown stats flag: $1" 2 ;;
        esac
    done

    [ -d "$DIALOG_DIR" ] || { printf '(no dialog directory at %s)\n' "$DIALOG_DIR"; return 0; }

    local f topic n_events body_bytes total_bytes status
    local total_topics=0 total_events=0 total_body_bytes=0

    printf '%-8s  %5s  %9s  %s\n' 'STATUS' 'EVENT' 'BODY-KB' 'TOPIC'
    printf '%-8s  %5s  %9s  %s\n' '------' '-----' '-------' '-----'
    for f in "$DIALOG_DIR"/*.jsonl; do
        [ -f "$f" ] || continue
        topic="$(basename "$f" .jsonl)"
        if [ -n "$topic_filter" ] && [ "$topic" != "$topic_filter" ]; then continue; fi

        n_events="$(wc -l < "$f" | tr -d ' ')"
        body_bytes="$(jq -r '.body | length' "$f" 2>/dev/null | awk '{s+=$1} END {print s+0}')"

        if jq -se 'any(.[]; .from == "user" and .type == "decision")' "$f" 2>/dev/null | grep -q '^true$'; then
            status='closed'
        else
            status='open'
        fi

        printf '%-8s  %5s  %9.1f  %s\n' "$status" "$n_events" "$(awk "BEGIN{print $body_bytes / 1024}")" "$topic"
        total_topics=$((total_topics + 1))
        total_events=$((total_events + n_events))
        total_body_bytes=$((total_body_bytes + body_bytes))
    done

    if [ "$total_topics" -eq 0 ]; then
        printf '(no topics)\n'
        return 0
    fi
    printf -- '------\n'
    printf 'totals: %d topic(s), %d event(s), %.1f KB body content\n' \
        "$total_topics" "$total_events" "$(awk "BEGIN{print $total_body_bytes / 1024}")"
    return 0
}

cmd_task_spec() {
    # Issue an opening type=task-spec event. Wrapper around cmd_post that
    # validates the required structured fields per spec §15.
    #
    # Per Codex 2026-05-11 P1: cmd_post alone only enforced from=user +
    # non-empty body. That let task-specs ship without acceptance,
    # files_in_scope, files_out_of_scope, max_tokens, or
    # max_wall_clock_seconds — the protocol's safety contract. The CLI
    # now rejects task-specs missing any of the §15-required fields.
    #
    # The body is markdown the agents read; we don't validate VALUE shapes
    # (still permissive) but we DO validate that the section headers exist.
    local body_arg=''
    local args=()
    local skip_next=0
    local i
    for ((i=1; i<=$#; i++)); do
        if [ "$skip_next" -eq 1 ]; then
            args+=("${!i}")
            skip_next=0
            continue
        fi
        case "${!i}" in
            --body)
                local next_idx=$((i+1))
                body_arg="${!next_idx:-}"
                args+=("${!i}")
                skip_next=1
                ;;
            *) args+=("${!i}") ;;
        esac
    done

    if [ -n "$body_arg" ]; then
        local missing=""
        local field
        for field in "acceptance:" "files_in_scope:" "files_out_of_scope:" "max_tokens:" "max_wall_clock_seconds:"; do
            if ! printf '%s\n' "$body_arg" | grep -qE "^${field}"; then
                missing="$missing $field"
            fi
        done
        if [ -n "$missing" ]; then
            die "task-spec body missing required fields:${missing}
Required per docs/tooling/agent-bus-spec.md §15: acceptance, files_in_scope, files_out_of_scope, max_tokens, max_wall_clock_seconds.
Recommended: max_turns, escalation_triggers, required_subagents, implementing_agent, reviewing_agent, depends_on, notes." 2
        fi
    fi

    cmd_post --type task-spec --from user "${args[@]}"
}

# Enforce AGENT_BUS_MAX_TOKENS / AGENT_BUS_MAX_WALL_CLOCK / AGENT_BUS_MAX_TURNS
# caps per spec §13. Called from cmd_post BEFORE writing. Env-var-driven
# enforcement; absent vars = no cap (current behavior).
# Hard cap (100%) = die with exit 1; warn at 80%.
#
# Per Codex 2026-05-11 P1 (ca1cc8ff): the prior signature only checked
# current topic bytes BEFORE writing, so a post that pushes total over
# the cap would land (current=9, cap=10, new=9 → wrote 18 bytes).
# Also, MAX_TURNS counted global AUTHOR env-var instead of the resolved
# --from flag, so AGENT_BUS_AUTHOR=user with --from claude bypassed the
# cap for claude. Both fixed.
#
# Signature: enforce_caps <topic> <candidate_body_bytes> <resolved_from>
enforce_caps() {
    local topic="$1"
    local candidate_body_bytes="${2:-0}"
    local resolved_from="${3:-$AUTHOR}"
    local file="$DIALOG_DIR/$topic.jsonl"

    # AGENT_BUS_MAX_TOKENS (body-byte budget, per spec §13 — ~4 bytes/token).
    # Check current + new against cap, not just current.
    if [ -n "${AGENT_BUS_MAX_TOKENS:-}" ]; then
        local current_bytes=0
        if [ -f "$file" ]; then
            current_bytes="$(jq -r '.body | length' "$file" 2>/dev/null | awk '{s+=$1} END {print s+0}')"
        fi
        local projected_bytes=$((current_bytes + candidate_body_bytes))
        if [ "$projected_bytes" -gt "$AGENT_BUS_MAX_TOKENS" ]; then
            die "AGENT_BUS_MAX_TOKENS=$AGENT_BUS_MAX_TOKENS exceeded by this post on topic '$topic' (current $current_bytes + new $candidate_body_bytes = $projected_bytes). Hard ceiling per spec §13. Post type=escalation + stop polling; user check-in needed." 1
        fi
        local threshold_80=$((AGENT_BUS_MAX_TOKENS * 8 / 10))
        if [ "$projected_bytes" -ge "$threshold_80" ]; then
            warn "AGENT_BUS_MAX_TOKENS at 80%+ on topic '$topic' (projected $projected_bytes / $AGENT_BUS_MAX_TOKENS bytes)"
        fi
    fi

    # AGENT_BUS_MAX_WALL_CLOCK (seconds since first event).
    if [ -n "${AGENT_BUS_MAX_WALL_CLOCK:-}" ] && [ -f "$file" ]; then
        local first_time_iso
        first_time_iso="$(jq -r '.time' "$file" 2>/dev/null | head -1)"
        if [ -n "$first_time_iso" ]; then
            local first_epoch=""
            if first_epoch="$(date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$first_time_iso" +%s 2>/dev/null)"; then :
            elif first_epoch="$(date -u -d "$first_time_iso" +%s 2>/dev/null)"; then :
            else first_epoch=""; fi
            if [ -n "$first_epoch" ]; then
                local now_epoch elapsed
                now_epoch="$(date -u +%s)"
                elapsed=$((now_epoch - first_epoch))
                if [ "$elapsed" -ge "$AGENT_BUS_MAX_WALL_CLOCK" ]; then
                    die "AGENT_BUS_MAX_WALL_CLOCK=$AGENT_BUS_MAX_WALL_CLOCK reached on topic '$topic' (elapsed: ${elapsed}s). Hard ceiling per spec §13. Post type=escalation + stop polling; user check-in needed." 1
                fi
                local wc_threshold_80=$((AGENT_BUS_MAX_WALL_CLOCK * 8 / 10))
                if [ "$elapsed" -ge "$wc_threshold_80" ]; then
                    warn "AGENT_BUS_MAX_WALL_CLOCK at 80%+ on topic '$topic' (${elapsed}s / ${AGENT_BUS_MAX_WALL_CLOCK}s)"
                fi
            fi
        fi
    fi

    # AGENT_BUS_MAX_TURNS (per-author event count on this topic). Count
    # by the resolved --from author (after the --from override), not by
    # the global AGENT_BUS_AUTHOR env var. The current post would push
    # the count from N to N+1, so check N+1 > cap.
    if [ -n "${AGENT_BUS_MAX_TURNS:-}" ]; then
        local author_count=0
        if [ -f "$file" ]; then
            author_count="$(jq -r --arg a "$resolved_from" 'select(.from == $a) | .from' "$file" 2>/dev/null | wc -l | tr -d ' ')"
        fi
        local projected_count=$((author_count + 1))
        if [ "$projected_count" -gt "$AGENT_BUS_MAX_TURNS" ]; then
            die "AGENT_BUS_MAX_TURNS=$AGENT_BUS_MAX_TURNS exceeded by this post for from=$resolved_from on topic '$topic' (current: $author_count, this post: +1 = $projected_count). Hard ceiling per spec §13. Mandatory user check-in." 1
        fi
        local t_threshold_80=$((AGENT_BUS_MAX_TURNS * 8 / 10))
        if [ "$projected_count" -ge "$t_threshold_80" ]; then
            warn "AGENT_BUS_MAX_TURNS at 80%+ for from=$resolved_from on topic '$topic' ($projected_count / $AGENT_BUS_MAX_TURNS events)"
        fi
    fi

    return 0
}

cmd_pending_reviews() {
    # List topics that have at least one commit-proposal event without a
    # subsequent ack/counter event FROM THE REVIEWING AGENT.
    #
    # Per Codex 2026-05-11 P2 (Q1 answer): the prior implementation counted
    # any ack/counter event as a response regardless of who posted it. With
    # the from-filter, the result is "topics where the named reviewer
    # (default: codex) has not yet responded to the latest commit-proposal."
    # --reviewer overrides the default for non-standard topic configs.
    local reviewer="codex"
    while [ $# -gt 0 ]; do
        case "$1" in
            --reviewer) reviewer="${2:-}"; shift 2 ;;
            *) die "unknown pending-reviews flag: $1" 2 ;;
        esac
    done

    if [ ! -d "$DIALOG_DIR" ]; then
        printf '(no dialog directory at %s)\n' "$DIALOG_DIR"
        return 0
    fi

    local f topic latest_commit_proposal_iso latest_ack_iso has_pending
    local found=0
    printf '%-50s  %s\n' 'TOPIC' 'STATE'
    printf '%-50s  %s\n' '-----' '-----'

    for f in "$DIALOG_DIR"/*.jsonl; do
        [ -f "$f" ] || continue
        topic="$(basename "$f" .jsonl)"

        # Skip closed topics (from=user + type=decision).
        if jq -se 'any(.[]; .from == "user" and .type == "decision")' "$f" 2>/dev/null | grep -q '^true$'; then
            continue
        fi

        # A commit-proposal is a claim event whose body starts with
        # 'commit-proposal:' (case-insensitive). We need to find the latest
        # one's sha256 + check whether any subsequent event references it
        # via in_reply_to.
        #
        # Computing the sha256 requires reading the raw line bytes (the
        # canonical encoding the post-time sha256 was computed from).
        # Approach: walk lines in order; identify commit-proposal lines;
        # hash each; collect; then walk again and collect ack/counter
        # in_reply_to values; set-diff.
        local proposals_file responses_file
        proposals_file="$(mktemp)"
        responses_file="$(mktemp)"

        # All commit-proposal sha256s with their iso times (sha + tab + iso),
        # in file order (= chronological order, append-only).
        while IFS= read -r line; do
            if [ -z "$line" ]; then continue; fi
            local _type _body_prefix _iso
            _type="$(printf '%s' "$line" | jq -r '.type // ""' 2>/dev/null || printf '')"
            if [ "$_type" != "claim" ]; then continue; fi
            _body_prefix="$(printf '%s' "$line" | jq -r '.body // ""' 2>/dev/null | head -c 30 | tr '[:upper:]' '[:lower:]')"
            case "$_body_prefix" in
                commit-proposal:*)
                    _iso="$(printf '%s' "$line" | jq -r '.time // ""' 2>/dev/null)"
                    printf '%s\t%s\n' "$(sha256_hex "$line")" "$_iso" >> "$proposals_file"
                    ;;
            esac
        done < "$f"

        # All ack/counter in_reply_to references FROM THE REVIEWER (one per
        # line, "" filtered out). Per Codex P2 (Q1): require from=$reviewer
        # so a non-reviewer ack doesn't accidentally clear the pending state.
        jq -r --arg rev "$reviewer" \
            'select((.type == "ack" or .type == "counter") and .from == $rev) | .in_reply_to // empty' \
            "$f" 2>/dev/null > "$responses_file" || true

        # Per Codex 2026-05-11 P2 fabc57a2: pending-reviews must only
        # check the LATEST commit-proposal per topic, not all of them.
        # An old unresponded proposal followed by a new responded
        # proposal should NOT mark the topic pending. File order is
        # chronological (append-only); the last commit-proposal in the
        # file is the latest.
        local has_unreplied=0
        local latest_pending_iso=''
        if [ -s "$proposals_file" ]; then
            local latest_proposal_line latest_proposal_sha latest_proposal_iso
            latest_proposal_line="$(tail -1 "$proposals_file")"
            latest_proposal_sha="$(printf '%s' "$latest_proposal_line" | cut -f1)"
            latest_proposal_iso="$(printf '%s' "$latest_proposal_line" | cut -f2)"
            if [ -n "$latest_proposal_sha" ]; then
                if ! grep -qFx -- "$latest_proposal_sha" "$responses_file"; then
                    has_unreplied=1
                    latest_pending_iso="$latest_proposal_iso"
                fi
            fi
        fi

        rm -f "$proposals_file" "$responses_file"

        if [ "$has_unreplied" -eq 1 ]; then
            found=1
            printf '%-50s  awaiting-review (proposal: %s)\n' "$topic" "$latest_pending_iso"
        fi
    done

    if [ "$found" -eq 0 ]; then
        printf '(no topics with pending review)\n'
        return 0
    fi
    # Exit 5 when pending reviews exist — caller can branch on this to
    # decide whether to wake the reviewer agent. exit 0 = nothing pending.
    return 5
}

cmd_unhandled_findings() {
    # List open topics where the reviewing agent (Codex by default) has
    # posted at least one event of type counter/evidence/question that
    # the implementing agent (Claude by default) has NOT yet replied to.
    # "Replied to" = some subsequent event from=claude with in_reply_to
    # matching the codex event's sha256.
    #
    # Why this exists (per Codex 2026-05-11 P1 review): `pending-reviews`
    # detects unreplied commit-proposals. After the reviewer posts a
    # counter, pending-reviews STOPS listing the topic (the counter IS the
    # response). That makes pending-reviews unsuitable as the inbox for
    # the implementing agent's review-pickup loop, because Claude needs to
    # see Codex's findings AFTER they land, not before. This subcommand
    # fills that gap.
    #
    # Exit codes: 0 = nothing unhandled; 5 = unhandled findings exist
    # (topics listed); 2 = arg error.
    local reviewer="codex"
    local implementer="claude"
    while [ $# -gt 0 ]; do
        case "$1" in
            --reviewer)    reviewer="${2:-}"; shift 2 ;;
            --implementer) implementer="${2:-}"; shift 2 ;;
            *) die "unknown unhandled-findings flag: $1" 2 ;;
        esac
    done

    if [ ! -d "$DIALOG_DIR" ]; then
        printf '(no dialog directory at %s)\n' "$DIALOG_DIR"
        return 0
    fi

    local f topic found=0
    printf '%-50s  %s\n' 'TOPIC' 'UNHANDLED-COUNT'
    printf '%-50s  %s\n' '-----' '---------------'

    for f in "$DIALOG_DIR"/*.jsonl; do
        if [ ! -f "$f" ]; then continue; fi
        topic="$(basename "$f" .jsonl)"

        # Skip closed topics.
        if jq -se 'any(.[]; .from == "user" and .type == "decision")' "$f" 2>/dev/null | grep -q '^true$'; then
            continue
        fi

        # Tier-2 filter (per Codex 2026-05-11 P1 9f5fcb18): only consider
        # topics that have at least one task-spec event. Tier-1 topics
        # (debate, brainstorm, example) don't participate in the
        # implementation review-pickup flow; including them produces
        # false review-pickups.
        if ! jq -se 'any(.[]; .type == "task-spec")' "$f" 2>/dev/null | grep -q '^true$'; then
            continue
        fi

        # Collect sha256 of every reviewer event of relevant type.
        local findings_file responses_file
        findings_file="$(mktemp)"
        responses_file="$(mktemp)"

        while IFS= read -r line; do
            if [ -z "$line" ]; then continue; fi
            local _from _type
            _from="$(printf '%s' "$line" | jq -r '.from // ""' 2>/dev/null || printf '')"
            _type="$(printf '%s' "$line" | jq -r '.type // ""' 2>/dev/null || printf '')"
            if [ "$_from" != "$reviewer" ]; then continue; fi
            case "$_type" in
                counter|evidence|question)
                    printf '%s\n' "$(sha256_hex "$line")" >> "$findings_file"
                    ;;
            esac
        done < "$f"

        # Collect in_reply_to from every implementer event (any type).
        jq -r --arg impl "$implementer" \
            'select(.from == $impl) | .in_reply_to // empty' \
            "$f" 2>/dev/null > "$responses_file" || true

        # Count findings without a matching response.
        local unhandled_count=0
        if [ -s "$findings_file" ]; then
            while IFS= read -r finding_sha; do
                if [ -z "$finding_sha" ]; then continue; fi
                if ! grep -qFx -- "$finding_sha" "$responses_file"; then
                    unhandled_count=$((unhandled_count + 1))
                fi
            done < "$findings_file"
        fi

        rm -f "$findings_file" "$responses_file"

        if [ "$unhandled_count" -gt 0 ]; then
            found=1
            printf '%-50s  %d\n' "$topic" "$unhandled_count"
        fi
    done

    if [ "$found" -eq 0 ]; then
        printf '(no unhandled %s findings on open topics)\n' "$reviewer"
        return 0
    fi
    return 5
}

cmd_cascade_check() {
    # Given a list of candidate files (--files comma-separated) representing
    # the files a candidate fix would touch, report which IN-FLIGHT topics
    # have overlapping files_in_scope. In-flight = task-spec landed AND no
    # task-complete posted AND no user-decision closure. If any overlap is
    # found, the fix carries cascade risk and should be deferred to user
    # triage per ADR-0012 §Component 6.
    local candidate_files_csv=''
    local target_topic=''
    while [ $# -gt 0 ]; do
        case "$1" in
            --files) candidate_files_csv="${2:-}"; shift 2 ;;
            --target-topic) target_topic="${2:-}"; shift 2 ;;
            *) die "unknown cascade-check flag: $1" 2 ;;
        esac
    done

    [ -n "$candidate_files_csv" ] || die "--files required (comma-separated list of candidate file paths)" 2

    [ -d "$DIALOG_DIR" ] || { printf '(no dialog directory at %s)\n' "$DIALOG_DIR"; return 0; }

    # Split candidate files into newline-separated for grep -F.
    local candidates
    candidates="$(printf '%s' "$candidate_files_csv" | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$' || true)"

    local f topic body_lower in_flight overlap_found
    overlap_found=0

    printf '%-50s  %s\n' 'IN-FLIGHT TOPIC' 'OVERLAP'
    printf '%-50s  %s\n' '---------------' '-------'

    for f in "$DIALOG_DIR"/*.jsonl; do
        if [ ! -f "$f" ]; then continue; fi
        topic="$(basename "$f" .jsonl)"

        # Skip the target topic itself (we're applying a fix TO it; overlap
        # with itself is expected).
        if [ -n "$target_topic" ] && [ "$topic" = "$target_topic" ]; then
            continue
        fi

        # In-flight = task-spec landed AND no task-complete AND no closure.
        # If jq fails (file has malformed JSON), treat as not-in-flight.
        in_flight="$(
            jq -se '
                any(.[]; .type == "task-spec") and
                (any(.[]; .type == "task-complete") | not) and
                (any(.[]; .from == "user" and .type == "decision") | not)
            ' "$f" 2>/dev/null || printf 'false'
        )"
        if [ "$in_flight" != "true" ]; then continue; fi

        # Pull the FULL task-spec body (multi-line).
        local body_raw
        body_raw="$(
            jq -r 'select(.type == "task-spec") | .body' "$f" 2>/dev/null \
                || printf ''
        )"
        if [ -z "$body_raw" ]; then continue; fi

        # Codex 2026-05-11 P1 fix: substring-matching the whole body
        # missed wildcard scope entries (e.g. files_in_scope contains
        # `Dots/**` but candidate `Dots/Foo.cs` is not a substring of
        # `Dots/**`). Fix: parse the files_in_scope section, normalize
        # trailing `/**` and `/*` into prefix-match form, then check
        # each candidate as either literal-exact OR prefix-match.
        local scope_paths
        scope_paths="$(printf '%s\n' "$body_raw" | awk '
            /^files_in_scope:/ { in_scope=1; next }
            in_scope && /^[A-Za-z_]+:/ { in_scope=0 }
            in_scope && /^[[:space:]]+-[[:space:]]/ {
                sub(/^[[:space:]]+-[[:space:]]+/, "")
                sub(/[[:space:]]+$/, "")
                if (length($0) > 0) print tolower($0)
            }
        ')"

        local overlapped_files=""
        if [ -z "$scope_paths" ]; then
            # Fallback when files_in_scope section absent: coarse-substring
            # match on the whole body. False-positive is safe per ADR-0012.
            local body_lower
            body_lower="$(printf '%s' "$body_raw" | tr '[:upper:]' '[:lower:]')"
            while IFS= read -r candidate; do
                if [ -z "$candidate" ]; then continue; fi
                local candidate_lower
                candidate_lower="$(printf '%s' "$candidate" | tr '[:upper:]' '[:lower:]')"
                if printf '%s' "$body_lower" | grep -qF -- "$candidate_lower"; then
                    overlapped_files="$overlapped_files $candidate"
                fi
            done <<< "$candidates"
        else
            # Structured prefix-aware match. Per ADR-0012 §Component 6,
            # false-positive is safe (over-counts overlap → user triage);
            # false-negative is dangerous (cascade bug ships).
            while IFS= read -r candidate; do
                if [ -z "$candidate" ]; then continue; fi
                local candidate_lower
                candidate_lower="$(printf '%s' "$candidate" | tr '[:upper:]' '[:lower:]')"
                while IFS= read -r path; do
                    if [ -z "$path" ]; then continue; fi
                    # Strip trailing wildcard variants:
                    #   foo/bar/**  -> foo/bar/  (prefix match)
                    #   foo/bar/*   -> foo/bar/  (prefix match)
                    #   foo/bar     -> foo/bar   (exact match)
                    local prefix="$path"
                    local has_wildcard=0
                    case "$prefix" in
                        *'**') has_wildcard=1; prefix="${prefix%\*\*}" ;;
                    esac
                    case "$prefix" in
                        *'*')  has_wildcard=1; prefix="${prefix%\*}" ;;
                    esac
                    if [ "$has_wildcard" -eq 1 ]; then
                        case "$candidate_lower" in
                            "$prefix"*)
                                overlapped_files="$overlapped_files $candidate"
                                break
                                ;;
                        esac
                    else
                        if [ "$candidate_lower" = "$prefix" ]; then
                            overlapped_files="$overlapped_files $candidate"
                            break
                        fi
                    fi
                done <<< "$scope_paths"
            done <<< "$candidates"
        fi

        if [ -n "$overlapped_files" ]; then
            overlap_found=1
            printf '%-50s  %s\n' "$topic" "$(printf '%s' "$overlapped_files" | sed 's/^ //')"
        fi
    done

    # Exit 0 on no overlap; exit 4 on overlap detected (advisory; caller
    # decides what to do — typically defer + escalate to user). Explicit
    # returns at each branch to avoid `set -e` killing on edge cases.
    if [ "$overlap_found" -eq 0 ]; then
        printf '(no in-flight topics overlap candidate files; cascade-safe per coarse check)\n'
        return 0
    fi
    return 4
}

cmd_help() {
    cat <<'EOF'
agent-bus — append-only JSONL dialog CLI (spec v0.2.0)

Usage:
  agent-bus post       --topic <id> --type <t> [--severity <p0|p1|p2|p3>]
                       --body <text> [--to <claude|codex|user|all>]
                       [--in-reply-to <sha256>] [--links <csv>]
  agent-bus claim      --topic <id> [--severity <p0..p3>] --body <text> [...]
  agent-bus task-spec  --topic <id> --body <markdown-task-spec> [...]
                       (issues type=task-spec; from=user only; spec §15)
  agent-bus read       --topic <id> [--since <iso>] [--from <e>]
                       [--type <e>] [--severity <e>]
  agent-bus list       [--open | --closed | --all]
  agent-bus stats      [--topic <id>]
                       (event count + body-bytes per topic; cost estimation)
  agent-bus archive    [--age-days <N>] [--dry-run]
                       (move closed topics older than N days, default 30,
                        to dialog/archive/YYYY-MM/; preserves audit trail)
  agent-bus pending-reviews [--reviewer <name>]
                       (list open topics with a commit-proposal claim event
                        but no subsequent ack/counter FROM THE REVIEWER;
                        default reviewer=codex. Used by /duo-implement to
                        track "awaiting review" state and by /codex-review-
                        loop to find topics needing reviewer attention.
                        NOT the right primitive for /check-reviews — use
                        unhandled-findings.)
  agent-bus unhandled-findings [--reviewer <name>] [--implementer <name>]
                       (list open topics where the reviewer has posted
                        counter/evidence/question events that the
                        implementer has NOT yet replied to via in_reply_to.
                        Defaults: reviewer=codex, implementer=claude. Used
                        by /check-reviews to find findings Claude needs
                        to address with cascade-prevention. Exit 5 = found,
                        exit 0 = nothing unhandled.)
  agent-bus cascade-check --files <csv> [--target-topic <id>]
                       (given candidate files a fix would touch, report
                        in-flight task-spec topics with overlapping scope;
                        exit 4 on overlap, exit 0 on cascade-safe. Used by
                        /check-reviews to gate fixes per ADR-0012 §6
                        cascade-prevention semantics. --target-topic
                        excludes the topic the fix targets itself.)
  agent-bus help
  agent-bus version

Env:
  AGENT_BUS_AUTHOR        claude | codex | user (default: user)
  AGENT_BUS_DIR           dialog directory (default: ./dialog)
  AGENT_BUS_MAX_TOKENS    Tier-2 cost cap (per-topic body bytes; ~4 bytes/token)
  AGENT_BUS_MAX_WALL_CLOCK Tier-2 wall-clock cap (seconds)
  AGENT_BUS_MAX_TURNS     Tier-2 turn cap (events per author)

Types (Tier-1, debate/brainstorm):
  claim counter evidence question decision ack note

Types (Tier-2, autonomous bounded-coding tasks per ADR-0012):
  task-spec      from=user only; opening event of /duo-implement topic
  escalation     hard stop on trigger; severity required (typically p0/p1)
  task-complete  agent posts when acceptance met + reviewer ack + commit landed

Severity: p0 p1 p2 p3
  required: claim, counter, evidence, escalation
  forbidden: note, ack, task-complete
  optional: question, decision, task-spec

Closure: a topic is closed when an event with from=user and type=decision
exists. Subsequent advisory events are allowed but do not re-open. To
overturn, open a new topic that cites the closed one in --links.

Append-only: dialog/*.jsonl files are immutable line-by-line; only line
additions at end-of-file are permitted. Enforced by
.claude/hooks/protect-dialog-append-only.sh PreToolUse hook.

Spec: docs/tooling/agent-bus-spec.md
ADRs: design/adr/adr-0011 (Editor MCP routing) + adr-0012 (autonomous Tier-2)
EOF
}

cmd_version() { printf 'agent-bus %s\n' "$VERSION"; }

# ---------- dispatch ----------

if [ $# -eq 0 ]; then cmd_help; exit 0; fi
sub="$1"; shift
case "$sub" in
    post)             require_jq; cmd_post "$@" ;;
    claim)            require_jq; cmd_claim "$@" ;;
    task-spec)        require_jq; cmd_task_spec "$@" ;;
    read)             require_jq; cmd_read "$@" ;;
    list)             require_jq; cmd_list "$@" ;;
    stats)            require_jq; cmd_stats "$@" ;;
    archive)          require_jq; cmd_archive "$@" ;;
    pending-reviews)       require_jq; cmd_pending_reviews "$@" ;;
    unhandled-findings)    require_jq; cmd_unhandled_findings "$@" ;;
    cascade-check)         require_jq; cmd_cascade_check "$@" ;;
    help|-h|--help)   cmd_help ;;
    version|-v|--version) cmd_version ;;
    *) die "unknown subcommand: $sub (try 'agent-bus help')" 2 ;;
esac
