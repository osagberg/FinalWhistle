#!/usr/bin/env bash
# Final Whistle — local command front-door
#
# Per design/production-pipeline.md: bash/makefile-first; no paid task runner.
# Commands are read-only checks / local build helpers / explicit stubs. Every
# command should either run a real check OR print a "not yet implemented at
# this phase" stub — never silently succeed on nothing.
#
# Usage: scripts/fw <command>
#        scripts/fw help

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

resolve_python() {
    if [ -n "${PYTHON:-}" ]; then
        printf '%s\n' "$PYTHON"
        return 0
    fi
    if command -v python3 >/dev/null 2>&1; then
        printf '%s\n' "python3"
        return 0
    fi
    if command -v python >/dev/null 2>&1; then
        printf '%s\n' "python"
        return 0
    fi
    return 1
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    help|-h|--help)
        cat <<'EOF'
Final Whistle — local command front-door

USAGE
    scripts/fw <command> [args]

COMMANDS (implemented)
    help            Print this message
    status          Read-only summary of repo state (git + active phase)
    verify          Tier-A umbrella — runs every implemented fast-PR check
    verify-docs     Doc frontmatter + unsubstituted-placeholder checks
    banned-terms    Category-A + Category-B banned-vocabulary lint
    banned-terms --report
                    Emit JSON of active Category-B exemptions (EA/RC audit)
    shader-audit    Grep viewer-adapter shaders (Assets/Viewer/) for banned
                    _Time refs per ADR-0008/0009 determinism contract.
                    UI / debug / loading-screen shaders are out of scope.
    build-unity-plugins
                    dotnet publish MatchSim + drop the DLLs into
                    unity-project/Assets/Plugins/MatchSim/ for Unity-side
                    consumption (per SPEC 2026-04-29 decisions log).
                    Run after every MatchSim source change before commit.
    test            dotnet test against FinalWhistle.slnx (MatchSim + tests)

COMMANDS (stubbed — land when their phase trigger hits)
    replay <seed>   Run one deterministic replay, print final hash (Phase 3)
    content-lint    Full content-pack validator (Phase 6)
    build-local     Unity build, current platform only (Phase 3)
    package-playtest   Signed build zip for itch upload (Phase 4)

Run `scripts/fw help <command>` for per-command detail (once implemented).
EOF
        ;;

    verify)
        # Tier-A umbrella. Calls every implemented fast-PR check in sequence.
        # New checks get wired in here as their deliverables land (see
        # design/production-pipeline.md §workflow-tiers Tier A).
        "$0" verify-docs
        "$0" banned-terms
        "$0" shader-audit
        "$0" test
        # Future additions: determinism smoke / corpus replay (Phase 3),
        # content-lint (Phase 6).
        ;;

    banned-terms)
        # Category-A (hard-ban) + Category-B (soft-ban w/ inline exemption)
        # vocabulary lint. Source of truth: design/ui-vocabulary.md.
        # Accepts --report for Category-B exemption audit JSON.
        python_cmd="$(resolve_python)" || {
            echo "FAIL: python3/python not found on PATH." >&2
            exit 2
        }
        exec "$python_cmd" "$ROOT/scripts/lint-banned-terms.py" --root "$ROOT" "$@" "$ROOT"
        ;;

    status)
        echo "=== Final Whistle — repo status ==="
        echo
        echo "Path:          $ROOT"
        echo -n "Branch:        "; git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "(not a git repo)"
        echo -n "Head:          "; git -C "$ROOT" log -1 --oneline 2>/dev/null || echo "(no commits)"
        echo -n "Clean?         "
        if [ -z "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]; then
            echo "yes"
        else
            echo "no (uncommitted changes)"
        fi
        echo
        echo "Active phase:"
        grep -m1 '🟡 ACTIVE' "$ROOT/SPEC.md" 2>/dev/null \
            | sed 's/^[[:space:]]*[-*#]\{1,\}[[:space:]]*//' \
            || echo "  (no active phase found in SPEC.md)"
        echo
        echo "Last updated (STATUS.md):"
        grep -m1 '^\*\*Last updated\*\*' "$ROOT/STATUS.md" 2>/dev/null \
            | sed 's/\*\*//g' \
            || echo "  (STATUS.md not found or missing Last updated line)"
        ;;

    verify-docs)
        echo "=== Final Whistle — verify-docs ==="
        echo
        exit_code=0

        # 1. Every design doc has frontmatter with `description`.
        echo "Checking design/**.md frontmatter..."
        while IFS= read -r -d '' f; do
            [ -f "$f" ] || continue
            if ! head -5 "$f" | grep -q '^description:'; then
                echo "  FAIL: $f missing 'description:' in frontmatter"
                exit_code=1
            fi
        done < <(find "$ROOT/design" -type f -name '*.md' -print0 2>/dev/null)

        # 2. No literal template placeholders in shipped docs.
        #    Legitimate exemption: sentinel-block pairs per design/ui-vocabulary.md
        #    2026-04-24 resolution — content between `ui-lint:ignore-start` and
        #    `ui-lint:ignore-end` markers is skipped (banned-term catalogs,
        #    historical meta-references to placeholders that were fixed, etc.).
        #    Also excludes .claude/bootstrap (source-of-truth), design-templates,
        #    and .claude/session-snapshots (auto-generated pre-compact artifacts).
        #
        #    Pattern matches both spaced ({{ PROJECT_NAME }}) and unspaced
        #    ({{PROJECT_NAME}}) forms — GPT-5.5 2026-04-24 feedback: the lint
        #    must catch both, never rely on spelling variants.
        echo "Checking for unsubstituted template placeholders..."
        placeholder_hits=""
        while IFS= read -r -d '' f; do
            case "$f" in
                */.claude/bootstrap/*|*/.claude/session-snapshots/*|*/design-templates/*|*/node_modules/*) continue ;;
                # Unity-generated dirs — never source-controlled, often contain
                # third-party package docs with non-UTF8 encodings or legitimate
                # Mustache-style template tokens that aren't ours. Always skip.
                */unity-project/Library/*|*/unity-project/Temp/*|*/unity-project/Logs/*|*/unity-project/Obj/*|*/unity-project/UserSettings/*|*/unity-project/MemoryCaptures/*|*/unity-project/Build/*|*/unity-project/Builds/*) continue ;;
            esac
            # Strip sentinel-ignored regions, then check for placeholder tokens.
            filtered=$(awk '
                /ui-lint:ignore-start/ {skip=1; next}
                /ui-lint:ignore-end/   {skip=0; next}
                !skip                  {print}
            ' "$f")
            if echo "$filtered" | grep -q '{{[[:space:]]*[A-Z_]\+[[:space:]]*}}'; then
                placeholder_hits="${placeholder_hits}${f}\n"
            fi
        done < <(find "$ROOT" -type f \( -name '*.md' -o -name '*.sh' \) \
            -not -path '*/unity-project/Library/*' \
            -not -path '*/unity-project/Temp/*' \
            -not -path '*/unity-project/Logs/*' \
            -not -path '*/unity-project/Obj/*' \
            -not -path '*/unity-project/UserSettings/*' \
            -not -path '*/unity-project/MemoryCaptures/*' \
            -not -path '*/unity-project/Build/*' \
            -not -path '*/unity-project/Builds/*' \
            -print0 2>/dev/null)

        if [ -n "$placeholder_hits" ]; then
            echo "  FAIL: placeholder tokens found (outside sentinel blocks):"
            printf "    %b" "$placeholder_hits" | sed 's/^/    /'
            exit_code=1
        fi

        # 3. Decisions-log is append-only discipline is enforced by hook at
        #    edit time — this is a light sanity check, not the hook.
        echo "Checking SPEC.md decisions-log is non-empty..."
        if ! grep -q '^- \*\*[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}\*\*' "$ROOT/SPEC.md"; then
            echo "  FAIL: SPEC.md decisions log has no dated entries"
            exit_code=1
        fi

        if [ "$exit_code" = "0" ]; then
            echo
            echo "OK: verify-docs clean"
        else
            echo
            echo "verify-docs found issues; see above"
        fi
        exit "$exit_code"
        ;;

    shader-audit)
        # Phase-3 Week-1 priority #6 — author-side determinism gate.
        #
        # ADR-0008 ShotPresentationContract + ADR-0009 dots-phase render adapter
        # both inherit ADR-0002's discipline that VIEWER ADAPTER shaders must
        # not read frame-time intrinsics. The match-replay corpus pins
        # adapter-keyed pass-activation hashes per seed; if a viewer-adapter
        # shader uses _Time / _SinTime / _CosTime / _DeltaTime /
        # _TimeParameters, the rendered output drifts per playback even
        # though the canonical MatchSim state is byte-identical. That
        # breaks the replay contract.
        #
        # Scope: VIEWER-ADAPTER shaders only.
        #
        # ADR-0008 explicitly exempts visual-only effects from the
        # determinism hash — meaning UI / debug / menu / loading-screen
        # shaders may legitimately use _Time (breathing-glow on selected
        # items, blinking cursors, animated loading indicators, etc.).
        # Those are NOT in the determinism path. Auditing them would
        # produce false-positives that block legitimate work.
        #
        # The audit therefore scans only the canonical viewer-adapter
        # tree: `unity-project/Assets/Viewer/` (the asmdef-rooted folder
        # for `Viewer.Contracts` / `Viewer.Core` / `Viewer.Adapters.Dots`
        # per ADR-0008/0009 asmdef plan). Shaders authored elsewhere in
        # the project — UI, debug, editor tools, post-match-screens — are
        # outside the determinism contract and intentionally not scanned.
        #
        # If a shader sits in `Assets/Viewer/` but legitimately needs
        # _Time (e.g., a non-replay-captured overlay rendered separately
        # from the viewer-adapter path), move it to a non-`Viewer/` path
        # OR raise an ADR that revisits the contract — don't suppress the
        # check inline.
        #
        # Phase-3-skeleton mode: when `Assets/Viewer/` doesn't exist yet
        # (current state — asmdef skeleton task hasn't landed), the script
        # exits 0 with a friendly "no viewer shaders to audit yet"
        # message. Same skeleton-stub pattern as `fw save-migration-test`
        # per the 2026-04-28 enforcement-skeleton-rollout decisions entry.
        # Real catch begins automatically the moment the dots adapter
        # authors its first shader under the viewer tree.
        #
        # On hit: prints `<file>:<line>: <matched-line>` for every offence
        # and exits non-zero. CI surfaces the failure via the existing
        # fast-pr-ci.yml `fw verify` umbrella.
        echo "=== Final Whistle — shader-audit ==="
        echo
        viewer_root="$ROOT/unity-project/Assets/Viewer"
        if [ ! -d "$viewer_root" ]; then
            echo "OK: unity-project/Assets/Viewer/ doesn't exist yet — no viewer-adapter shaders to audit."
            echo "(Phase-3 stub-active mode; first viewer-adapter shader under that tree trips real catch.)"
            exit 0
        fi

        # Collect viewer-adapter shader-family files. Scope is the
        # asmdef-rooted Viewer/ tree per ADR-0008/0009 — UI / debug /
        # editor / loading-screen shaders elsewhere in Assets/ are
        # intentionally outside this audit.
        shader_files=$(find "$viewer_root" \
            -type f \
            \( -name '*.shader' -o -name '*.hlsl' -o -name '*.cginc' -o -name '*.shadergraph' -o -name '*.subshader' \) \
            2>/dev/null)

        if [ -z "$shader_files" ]; then
            echo "OK: no viewer-adapter shader files under unity-project/Assets/Viewer/ yet."
            echo "(Phase-3 stub-active mode; first viewer-adapter shader under that tree trips real catch.)"
            exit 0
        fi

        # Banned shader-time intrinsic names. Trailing-boundary anchor uses a
        # POSIX-portable negative bracket class instead of `\b` (which is NOT
        # supported by BSD `grep -E` on macOS). The trailing `[^A-Za-z0-9_]`
        # excludes false-positives like `_TimeOfDay` while still catching
        # `_Time.y` / `_Time;` / `_Time,` / `_Time)` etc. — the dot,
        # semicolon, comma, paren are all non-identifier chars. The `|$`
        # branch handles end-of-line / end-of-file occurrences.
        # Patterns:
        #   _Time, _SinTime, _CosTime, _DeltaTime, _TimeParameters — HLSL globals
        #   `TimeNode` — appears in .shadergraph JSON as e.g.
        #     `"m_Type": "UnityEditor.ShaderGraph.TimeNode"`
        banned_pattern='_(Time|SinTime|CosTime|DeltaTime|TimeParameters)([^A-Za-z0-9_]|$)|TimeNode'

        echo "Scanning viewer-adapter shader files (Assets/Viewer/) for banned _Time refs..."
        echo "$shader_files" | sed "s|^$ROOT/||" | sort | sed 's/^/  /'
        echo

        hits=0
        while IFS= read -r f; do
            [ -f "$f" ] || continue
            # `grep -nE` prints `<line>:<text>`; we prefix with the file path.
            file_hits=$(grep -nE "$banned_pattern" "$f" 2>/dev/null || true)
            if [ -n "$file_hits" ]; then
                rel="${f#$ROOT/}"
                echo "  FAIL: $rel"
                printf '%s\n' "$file_hits" | sed "s|^|    |"
                hits=$((hits + 1))
            fi
        done <<EOF
$shader_files
EOF

        if [ "$hits" -eq 0 ]; then
            echo "OK: shader-audit clean — no banned _Time refs in viewer-adapter shaders."
            exit 0
        fi

        echo
        echo "shader-audit FAIL: $hits file(s) under Assets/Viewer/ reference banned _Time intrinsics."
        echo "  Replays must be pixel-stable per ADR-0008/0009. Resolution:"
        echo "    - Remove the _Time-driven visual from the shader, OR"
        echo "    - Move the shader OUT of Assets/Viewer/ if it's actually a UI /"
        echo "      debug / loading / non-replay-captured surface (those paths are"
        echo "      not in the determinism hash and are not audited)."
        echo "  If neither resolution fits, raise an ADR that revisits the contract."
        exit 1
        ;;

    build-unity-plugins)
        # MatchSim → Unity DLL-drop bundler (per SPEC 2026-04-29 decisions log
        # — MatchSim consumption strategy = checked-in DLL drop with this
        # script as the explicit rebuild gate).
        #
        # Pipeline:
        #   1. `dotnet publish MatchSim/MatchSim.csproj -c Release` — required
        #      (NOT `dotnet build`, which doesn't copy transitive NuGet deps
        #      for class libraries). Publish puts `FinalWhistle.MatchSim.dll`
        #      + `FinalWhistle.MatchSim.pdb` + `YamlDotNet.dll` together.
        #   2. Copy the three files into `unity-project/Assets/Plugins/MatchSim/`.
        #      Skipped: `.deps.json` (runtime-host manifest; Unity ignores it)
        #      + `.xml` doc-comment file (~87KB, no Editor benefit yet).
        #   3. Existing `.meta` files are NEVER overwritten — Unity owns GUID
        #      stability for these DLLs, and the .meta survives across runs
        #      so existing Unity scenes / asmdef references stay valid.
        #
        # First-run user-action: after the script runs the first time, open
        # Unity once so it generates `.meta` files for the new DLLs, then
        # commit those .meta files. Subsequent runs only refresh the DLL
        # bytes; .meta stability is preserved.
        #
        # Idempotency: re-running with no MatchSim source change is a no-op
        # at the dotnet-publish layer (incremental build) + the cp layer
        # overwrites bytes only if they differ.
        echo "=== Final Whistle — build-unity-plugins ==="
        echo
        if ! command -v dotnet >/dev/null 2>&1; then
            echo "FAIL: dotnet SDK not found on PATH." >&2
            echo "Install .NET 10+ SDK; see SETUP.md §4." >&2
            exit 2
        fi

        matchsim_proj="$ROOT/MatchSim/MatchSim.csproj"
        if [ ! -f "$matchsim_proj" ]; then
            echo "FAIL: $matchsim_proj missing." >&2
            exit 2
        fi

        target_dir="$ROOT/unity-project/Assets/Plugins/MatchSim"
        publish_tmp=$(mktemp -d -t fw-build-unity-plugins.XXXXXX)
        # Bash trap to remove the temp dir even on failure mid-script.
        trap 'rm -rf "$publish_tmp"' EXIT

        echo "Publishing MatchSim (Release, netstandard2.1) to staging…"
        dotnet publish "$matchsim_proj" \
            -c Release \
            --nologo \
            -o "$publish_tmp" \
            >/dev/null

        # Verify the expected files arrived.
        for required in FinalWhistle.MatchSim.dll YamlDotNet.dll; do
            if [ ! -f "$publish_tmp/$required" ]; then
                echo "FAIL: $required missing from publish output ($publish_tmp)." >&2
                exit 2
            fi
        done

        echo "Staging DLLs in $target_dir…"
        mkdir -p "$target_dir"

        # Copy ONLY the files Unity actually needs. .deps.json + .xml stay
        # in the staging dir (will be cleaned by the trap). PDB is included
        # because Unity uses managed-PDBs for real stack traces in the Editor.
        copied=0
        for f in FinalWhistle.MatchSim.dll FinalWhistle.MatchSim.pdb YamlDotNet.dll; do
            if [ ! -f "$publish_tmp/$f" ]; then
                # PDB may not exist on Release; that's OK, just skip it.
                if [ "$f" = "FinalWhistle.MatchSim.pdb" ]; then
                    continue
                fi
                echo "FAIL: $f missing from publish output." >&2
                exit 2
            fi
            cp "$publish_tmp/$f" "$target_dir/$f"
            copied=$((copied + 1))
        done

        echo
        echo "OK: copied $copied file(s) to $target_dir"

        # First-run guidance — only mention if any plugin .meta file is missing.
        missing_metas=0
        for f in "$target_dir/FinalWhistle.MatchSim.dll" "$target_dir/YamlDotNet.dll"; do
            if [ -f "$f" ] && [ ! -f "$f.meta" ]; then
                missing_metas=$((missing_metas + 1))
            fi
        done
        if [ "$missing_metas" -gt 0 ]; then
            echo
            echo "First-run note: $missing_metas DLL(s) lack .meta files."
            echo "  Open Unity once so the Editor generates .meta files for the new"
            echo "  plugins, then commit them alongside the DLLs. After that, future"
            echo "  runs of this command preserve .meta stability automatically."
        fi
        ;;

    test)
        # Phase-3 Week-1 deliverable: dotnet test against MatchSim solution.
        # Wired into `fw verify` umbrella so Tier-A CI picks this up
        # automatically per design/production-pipeline.md §Tier-A.
        echo "=== Final Whistle — dotnet test ==="
        echo
        if ! command -v dotnet >/dev/null 2>&1; then
            echo "FAIL: dotnet SDK not found on PATH." >&2
            echo "Install .NET 10+ SDK; see SETUP.md §4." >&2
            exit 2
        fi
        # Solution file is .slnx (XML) per .NET 10 default.
        solution="$ROOT/FinalWhistle.slnx"
        if [ ! -f "$solution" ]; then
            echo "FAIL: $solution missing." >&2
            exit 2
        fi
        # `--nologo` keeps output focused; `-c Release` is overkill for Tier-A
        # and slower than Debug — stay on default Debug for fast-PR cadence.
        exec dotnet test "$solution" --nologo "$@"
        ;;

    replay|content-lint|build-local|package-playtest)
        cat >&2 <<EOF
fw: '$cmd' is not implemented yet at this phase.

Implementation lands at its phase trigger:
  replay / build-local         Phase 3 (Unity bootstrap + MatchSim prototype)
  package-playtest             Phase 4 (closed itch distribution)
  content-lint                 Phase 6 (full content-pack validator)

See design/production-pipeline.md for the overall plan.
EOF
        exit 2
        ;;

    *)
        echo "fw: unknown command '$cmd'" >&2
        echo "Try 'scripts/fw help' for a list of commands." >&2
        exit 2
        ;;
esac
