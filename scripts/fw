#!/usr/bin/env bash
# Final Whistle — dev front-door (Rust pivot).
#
# Bash umbrella that delegates to `just` recipes (T0-8). `fw verify` is
# the canonical pre-commit check; CLAUDE.md §4.5 requires it green
# before every commit. CI workflows invoke cargo/pnpm directly rather
# than going through `fw`, so this script's availability is a dev-box
# convenience, not a CI dependency.
#
# Usage: scripts/fw <command> [args]
#        scripts/fw help

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cmd="${1:-help}"
shift || true

# Resolve `just`. If missing, point the user at the install line instead
# of producing the cryptic "command not found" error.
require_just() {
    if ! command -v just >/dev/null 2>&1; then
        cat >&2 <<'EOF'
fw: `just` is required but not on PATH.

Install:
  macOS:        brew install just
  Linux:        cargo install just
  Windows:      choco install just  OR  cargo install just

See https://github.com/casey/just for other install paths.
EOF
        exit 2
    fi
}

case "$cmd" in
    help|-h|--help)
        cat <<'EOF'
Final Whistle — dev front-door (Rust pivot)

USAGE
    scripts/fw <command> [args]

COMMANDS
    verify           Full pre-commit gate: lint + test + banned-terms + canonical-hash
    dev              Launch Tauri dev mode
    test [args]      cargo test --workspace (forwards args to cargo test)
    test-determinism Run the canonical-hash regression in isolation
    lint             cargo fmt --check + clippy + frontend lint + typecheck
    fmt              Auto-fix formatting (cargo fmt + pnpm format)
    banned-terms     Football-native vocabulary lint
    verify-content   FW-VAL content-pack validation
    determinism-audit  rg-based audit for HashMap / tokio / clocks in sim crates
    build            cargo build --workspace
    bundle           Full Tauri bundle for current platform
    clean            Purge target/ + frontend/node_modules
    bake             Regenerate content corpus (T2+ stub until baker lands)
    cross-check      Smoke-compile Win/Linux targets from Mac via cargo-zigbuild
    help             Print this message

NOTES
    All commands are thin wrappers around `just` recipes. Run `just --list`
    for the full recipe catalog if you'd rather invoke just directly.
EOF
        ;;

    verify)
        require_just
        cd "$ROOT"
        just ci-local
        ;;

    dev)
        require_just
        cd "$ROOT"
        just dev
        ;;

    test)
        require_just
        cd "$ROOT"
        # Forward extra args to `cargo test` via a recipe arg form. The
        # bare recipe doesn't take args; for filter / single-test work,
        # invoke cargo directly: `cargo test --workspace <filter>`.
        if [ "$#" -eq 0 ]; then
            just test
        else
            cargo test --workspace --release "$@"
        fi
        ;;

    test-determinism)
        require_just
        cd "$ROOT"
        just test-determinism
        ;;

    lint)
        require_just
        cd "$ROOT"
        just lint
        ;;

    fmt)
        require_just
        cd "$ROOT"
        just fmt
        ;;

    build)
        require_just
        cd "$ROOT"
        just build-debug
        ;;

    bundle)
        require_just
        cd "$ROOT"
        just bundle
        ;;

    clean)
        require_just
        cd "$ROOT"
        just clean
        ;;

    bake)
        require_just
        cd "$ROOT"
        just bake-content
        ;;

    cross-check)
        require_just
        cd "$ROOT"
        just cross-check
        ;;

    banned-terms)
        require_just
        cd "$ROOT"
        just banned-terms
        ;;

    verify-content)
        require_just
        cd "$ROOT"
        just verify-content
        ;;

    determinism-audit)
        require_just
        cd "$ROOT"
        just determinism-audit
        ;;

    *)
        echo "fw: unknown command '$cmd'" >&2
        echo "Run 'scripts/fw help' for a list of commands." >&2
        exit 2
        ;;
esac
