+
+/// Clearance radius for the blocker scan: MIN_PLAYER_DISTANCE × 1.5 ≈ 0.6m.
+///
+/// Raw bits = round(0.6 × 2^32) = 2_576_980_377.
+const CLEARANCE_RADIUS: Q32 = Q32::from_raw(2_576_980_377_i64);
+
+/// Squared clearance radius: CLEARANCE_RADIUS² ≈ 0.36m².
+///
+/// Raw bits = round(0.36 × 2^32) = 1_546_188_227.
