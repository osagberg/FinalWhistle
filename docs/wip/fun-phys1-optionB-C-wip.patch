+        let perp_sq = q_dist_sq - proj_sq;
+        if perp_sq >= CLEARANCE_RADIUS_SQ {
+            continue; // outside clearance radius
+        }
+
+        // Blocker is within the clearance radius of the approach segment.
+        blocker_count += 1;
