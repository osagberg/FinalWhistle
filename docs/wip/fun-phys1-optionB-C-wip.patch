+/// Waypoint lateral offset magnitude ≈ 0.6m (= CLEARANCE_RADIUS).
+///
+/// The waypoint is placed `ball + perpendicular_unit × WAYPOINT_OFFSET` so
+/// that the two chasers diverge toward the ball from different angles.
+const WAYPOINT_OFFSET: Q32 = CLEARANCE_RADIUS;
+
+/// Minimum projection along the chaser→ball segment for a blocker to count.
+///
+/// 0.5m in Q32: raw = round(0.5 × 2^32) = 2_147_483_648.
+const MIN_PROJ: Q32 = Q32::from_raw(2_147_483_648_i64);
+
+/// Scan opponent slots for a blocker on the (chaser → ball) straight-line path.
+///
+/// Returns `Some(MoveToPosition { target: waypoint })` when exactly one opponent
+/// blocks the direct approach and a clean lateral waypoint can be computed.
+/// Returns `None` (fall through to direct chase) when:
+/// - No blocker is found.
+/// - Multiple blockers are found (ambiguous; direct approach is safest).
+/// - The approach distance is so small that projection gating is meaningless
+///   (< 1m — the two players are essentially already at the ball).
+///
+/// ## Geometry
+///
+/// The approach unit vector `u = (ball - chaser) / dist`. A candidate blocker
+/// at position `q` passes the filter when:
+/// - `proj = (q - chaser) · u ∈ [0.5m, dist - 0.5m]` (between guards)
+/// - `perp_dist = sqrt((q - chaser)_dist_sq - proj²) < CLEARANCE_RADIUS`
+///
+/// The perpendicular unit vector is the 90° rotation of `u`:
+/// `perp_unit = (-u.y, u.x)` (signed by blocker's Y offset from the approach
+/// line, matching the `drop_loose_ball` convention).
+fn compute_waypoint_deflection(
+    state: &MatchState,
+    chaser_slot: usize,
+    ball_x: Q32,
+    ball_y: Q32,
+) -> Option<PlayerIntent> {
+    let chaser = &state.players[chaser_slot];
+    let cx = chaser.pos_x;
+    let cy = chaser.pos_y;
