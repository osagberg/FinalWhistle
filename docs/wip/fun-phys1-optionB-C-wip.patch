+            blocker_y_raw = opp.pos_y.to_bits();
+        } else {
+            // More than one blocker — ambiguous, fall through to direct chase.
+            return None;
+        }
+    }
+
+    if blocker_count != 1 {
+        return None; // no blocker found
+    }
+
+    // Compute lateral waypoint: ball + perp_unit × WAYPOINT_OFFSET.
+    //
+    // perp_unit = 90° rotation of (ux, uy):
+    //   left rotation:  (-uy, ux)
+    //   right rotation: (uy, -ux)
+    //
+    // Sign convention: offset AWAY from the blocker in Y.
+    // If blocker's Y > ball's Y → blocker is above → offset downward (−Y).
+    // Use the blocker's signed Y raw to determine side, then pick the
+    // rotation that moves AWAY from the blocker.
+    //
+    // The perpendicular to (ux, uy) is either (-uy, ux) or (uy, -ux).
+    // (-uy, ux) rotates 90° CCW: moves in +Y when ux > 0.
+    // (uy, -ux) rotates 90° CW: moves in -Y when ux > 0.
+    //
+    // We want to move AWAY from blocker. If blocker_y > ball_y, move down
