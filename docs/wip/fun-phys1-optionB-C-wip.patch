+++ b/crates/fw-match-sim/tests/phys1_no_clip_proptest.rs
@@ -0,0 +1,235 @@
+//! FUN-PHYS-1 acceptance-gate test — Option B + C collision-aware movement.
+//!
+//! Acceptance gate: across all 40 drama-sweep seeds, no two players have
+//! Euclidean distance < MIN_PLAYER_DISTANCE - CORDIC_ULP_M for more than
+//! 1 consecutive tick in a full 5400-tick match.
+//!
+//! ## Threshold rationale
+//!
+//! The separation pass places players at exactly `MIN_PLAYER_DISTANCE` apart
+//! using CORDIC-backed `Q32::sqrt`. CORDIC underestimates by up to ~1 ULP,
+//! which means the resulting `dx` may be `MIN_PLAYER_DISTANCE - ~0.000233m`
+//! after a correction. The squared comparison `dx² < MIN_PLAYER_DISTANCE_SQ`
+//! would falsely flag these as overlapping for 100+ ticks even with zero
+//! velocity (pure CORDIC oscillation at the threshold — not a real clip).
+//!
+//! We use the corrected threshold:
+//!   `OVERLAP_THRESHOLD_SQ = (MIN_PLAYER_DISTANCE - CORDIC_MARGIN_M)²`
+//! where `CORDIC_MARGIN_M ≈ 0.25mm` — larger than the observed CORDIC error
+//! of ~0.23mm, tight enough to catch any real clip above ~0.65mm.
+//!
+//! This matches the spirit of the separation.rs unit tests which allow
+//! `Q32::from_raw(4096)` ULP tolerance on the distance.
+//!
+//! The ORIGINAL 150mm/62-tick clip-through from seed 7834583133621575731 was
+//! measured as `150mm = 0.15m`, far above the `0.25mm` CORDIC margin — it
+//! would clearly fail this gate. Any real clip-through involving velocity
+//! will also far exceed this margin.
+//!
+//! ## Honesty contract
+//!
+//! This test MUST NOT be:
+//! - `#[ignore]`d to hide a real clip-through
+//! - replaced by a shorter tick budget that hides scramble scenarios
+//! - given a tolerance large enough to mask real physics violations
+//!
+//! The `CORDIC_MARGIN_M = 0.00025m (0.25mm)` tolerance is the ONLY
+//! acceptable source of looseness — it compensates for measurement
+//! precision in Q32 arithmetic, not for actual overlapping players.
+
+use fw_core::{Q32, Seed};
+use fw_match_sim::{MatchState, separation::MIN_PLAYER_DISTANCE, tick_match};
+use std::collections::BTreeMap;
+
+/// Base seed for the 40-seed drama sweep. Matches the drama_sweep binary
+/// default (seed_i = BASE_SEED + i for i in 0..40).
+const BASE_SEED: u64 = 0;
+
+/// Number of seeds in the drama sweep.
+const N_SEEDS: usize = 40;
+
+/// Full match tick budget (5400 ticks = 90 game-minutes at 60 ticks/min).
+const FULL_MATCH_TICKS: u32 = fw_match_sim::FULL_MATCH_TICKS;
+
+/// Maximum allowed consecutive ticks of overlap for any pair.
+/// The acceptance gate is ≤ 1 consecutive tick.
+const MAX_ALLOWED_CONSECUTIVE_OVERLAP: u32 = 1;
+
+/// CORDIC margin: how much below MIN_PLAYER_DISTANCE a pair may sit due to
+/// CORDIC sqrt underestimation in the separation pass, without counting as
+/// a real clip-through.
+///
+/// 0.25mm = 0.00025m in Q32: raw = round(0.00025 × 2^32) = 1_073_742
+/// (rounded up from 1_073_741.824).
+///
+/// Observed CORDIC underestimation: ~0.23mm (raw bits difference ≈ 1_000_000).
+/// This margin is set to 0.25mm (> 0.23mm observed) to be safe, while still
+/// being far below any real clip-through (the original 150mm case was 600×
+/// this threshold).
+const CORDIC_MARGIN_M: Q32 = Q32::from_raw(1_073_742_i64);
+
+/// Effective overlap threshold distance: MIN_PLAYER_DISTANCE - CORDIC_MARGIN_M.
+///
+/// A pair is only counted as "overlapping" for this test when their distance
+/// is below this threshold — i.e., they are clearly physically overlapping,
+/// not just sitting at the CORDIC rounding boundary.
+///
+/// Computed as MIN_PLAYER_DISTANCE (0.4m) - CORDIC_MARGIN_M (0.00025m) =
+/// 0.39975m.
+///
+/// Note: const fn subtraction for Q32 is not available, so we precompute:
+/// MIN_PLAYER_DISTANCE raw = 1_717_986_918
+/// CORDIC_MARGIN_M raw = 1_073_742
+/// threshold raw = 1_717_986_918 - 1_073_742 = 1_716_913_176
+const OVERLAP_THRESHOLD: Q32 = Q32::from_raw(1_716_913_176_i64);
+
+/// Overlap threshold squared (for fast comparison without sqrt).
+///
+/// OVERLAP_THRESHOLD² ≈ 0.39975² ≈ 0.15980m²
+/// In Q32: 1_716_913_176² / 2^32 ≈ 685_585_397
+///
+/// Computed: (1_716_913_176)² / 4_294_967_296 = 2_947_785_578_406_406_976 / 4_294_967_296
+/// ≈ 686_406_640 — let me be precise:
+/// 1_716_913_176² = 2_947_791_484_438_830_976
+/// / 4_294_967_296 = 686_408_174 (integer division)
+///
+/// Let me compute 1_716_913_176 × 1_716_913_176:
+/// ≈ (1.717e9)² = 2.948e18
+/// / 2^32 = 2.948e18 / 4.295e9 = 6.864e8 ≈ 686_400_000
+///
+/// For safety, we use the value computed from:
+/// (1_716_913_176 as i128)² >> 32 = ?
+/// 1_716_913_176² = 2_947_791_490_606_054_976... let me just use a slightly
+/// conservative value: 685_200_000 (clearly below 0.16m² = 687_194_767)
+///
+/// Actually: the cleanest approach is to compare distances (not squared) in
+/// the test loop, accepting the sqrt cost. This avoids the squared-threshold
+/// precision issue entirely.
+const N_PLAYERS: usize = 22;
+
+/// Number of unique pairs: C(22,2) = 231.
+const N_PAIRS: usize = N_PLAYERS * (N_PLAYERS - 1) / 2;
+
+#[test]
+fn phys1_no_clip_through_beyond_1_tick_across_40_seeds() {
+    let sig_defs = BTreeMap::new();
+
+    let mut global_max_consecutive: u32 = 0;
+    let mut worst_seed: u64 = 0;
+    let mut worst_pair: (usize, usize) = (0, 0);
+    let mut worst_tick: u32 = 0;
+
+    for i in 0..N_SEEDS {
+        let seed_u64 = BASE_SEED.wrapping_add(i as u64);
+        let seed = Seed::from_u64(seed_u64);
+        let mut state = MatchState::initial(seed);
+
+        // Track consecutive overlap ticks per pair.
+        let mut consecutive: [u32; N_PAIRS] = [0; N_PAIRS];
+
+        for tick in 0..FULL_MATCH_TICKS {
+            state = tick_match(state, &sig_defs);
+
+            // Check all 231 pairs.
+            for a in 0..N_PLAYERS {
+                for b in (a + 1)..N_PLAYERS {
+                    let dx = state.players[b].pos_x - state.players[a].pos_x;
+                    let dy = state.players[b].pos_y - state.players[a].pos_y;
+                    let dist_sq = dx * dx + dy * dy;
+
+                    let pair_idx = pair_index(a, b);
+
+                    // Use sqrt for the distance comparison to avoid CORDIC
+                    // squared-value precision artifacts. Two players placed at
+                    // exactly MIN_PLAYER_DISTANCE by the separation pass will
+                    // have dist_sq slightly below MIN_PLAYER_DISTANCE_SQ due
+                    // to Q32 multiplication rounding, but their sqrt-distance
+                    // will equal MIN_PLAYER_DISTANCE within CORDIC_MARGIN_M.
+                    //
+                    // Skip the sqrt on the trivially-not-overlapping fast path
+                    // using the squared threshold. MIN_PLAYER_DISTANCE_SQ is
+                    // exactly 0.16m² = raw 687_194_767.
+                    // We use a slightly-smaller squared threshold for the fast
+                    // path to ensure we don't skip pairs that might be near
+                    // the boundary:
+                    //   fast_skip_threshold_sq = 0.15m² = raw 644_245_094
+                    // Pairs above this are definitely not overlapping.
+                    const FAST_SKIP_SQ: Q32 = Q32::from_raw(644_245_094_i64); // 0.15m² exactly
+                    if dist_sq >= FAST_SKIP_SQ {
+                        // Definitely not overlapping by a wide margin — skip sqrt.
+                        consecutive[pair_idx] = 0;
+                        continue;
+                    }
+
+                    // Near the boundary: compute actual distance via sqrt.
+                    let dist = dist_sq.sqrt();
+                    let is_overlap = dist < OVERLAP_THRESHOLD;
+
+                    if is_overlap {
+                        consecutive[pair_idx] += 1;
+                        let c = consecutive[pair_idx];
+                        if c > global_max_consecutive {
+                            global_max_consecutive = c;
+                            worst_seed = seed_u64;
+                            worst_pair = (a, b);
+                            worst_tick = tick;
+                        }
+                    } else {
+                        consecutive[pair_idx] = 0;
+                    }
+                }
+            }
+        }
+    }
+
+    assert!(
+        global_max_consecutive <= MAX_ALLOWED_CONSECUTIVE_OVERLAP,
+        "FUN-PHYS-1 acceptance gate FAILED: max consecutive overlap = {} ticks \
+         (allowed: {}). Worst case: seed={}, pair=({},{}), ending at tick {}.\n\
+         OVERLAP_THRESHOLD = {:?} (MIN_PLAYER_DISTANCE={:?} - CORDIC_MARGIN={:?}).\n\
+         This is a real clip-through, not a CORDIC rounding artifact.\n\
+         Option B + C did not eliminate sustained physical overlap.",
+        global_max_consecutive,
+        MAX_ALLOWED_CONSECUTIVE_OVERLAP,
+        worst_seed,
+        worst_pair.0,
+        worst_pair.1,
+        worst_tick,
+        OVERLAP_THRESHOLD,
+        MIN_PLAYER_DISTANCE,
+        CORDIC_MARGIN_M,
+    );
+}
+
+/// Compute the flat index into the 231-pair array for pair (a, b) with a < b.
+///
+/// Formula: sum of (N-k) for k in 0..a, plus (b - a - 1).
+/// Equivalently: a*(2*N - a - 1)/2 + (b - a - 1) where N = 22.
+fn pair_index(a: usize, b: usize) -> usize {
+    debug_assert!(a < b, "pair_index requires a < b");
+    debug_assert!(b < N_PLAYERS, "pair_index: b={b} out of range");
+    let base = a * (2 * N_PLAYERS - a - 1) / 2;
+    base + (b - a - 1)
+}
+
+/// Check that the CORDIC_MARGIN_M constant is meaningful:
+/// must be > 0 and < MIN_PLAYER_DISTANCE / 100 (i.e. < 4mm).
+#[test]
+fn cordic_margin_sanity() {
+    assert!(
+        CORDIC_MARGIN_M > Q32::ZERO,
+        "CORDIC_MARGIN_M must be positive"
+    );
+    // 4mm = 0.004m, raw = round(0.004 × 2^32) = 17_179_869
+    let four_mm = Q32::from_raw(17_179_869_i64);
+    assert!(
+        CORDIC_MARGIN_M < four_mm,
+        "CORDIC_MARGIN_M ({:?}) must be less than 4mm — too wide a margin hides real clips",
+        CORDIC_MARGIN_M,
+    );
+    // OVERLAP_THRESHOLD must be less than MIN_PLAYER_DISTANCE
+    assert!(
+        OVERLAP_THRESHOLD < MIN_PLAYER_DISTANCE,
+        "OVERLAP_THRESHOLD must be < MIN_PLAYER_DISTANCE"
+    );
+}
