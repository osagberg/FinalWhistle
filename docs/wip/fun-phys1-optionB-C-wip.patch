+    let blocker_above = blocker_y_raw > ball_y_raw;
+
+    // CW rotation: (uy, -ux) — net Y component is -ux (negative for rightward approach).
+    // CCW rotation: (-uy, ux) — net Y component is ux (positive for rightward approach).
+    //
+    // For simplicity, derive sign from the approach direction and blocker side:
+    // perpendicular_y = if blocker_above { -uy } else { uy }
+    // perpendicular_x = if blocker_above { ux } else { -ux }
+    //
+    // This matches the "rotate 90° AWAY from the blocker" intent:
+    // - blocker above (Y+): offset goes downward (Y−) → CW rotation → (uy, -ux)
+    // - blocker below (Y−): offset goes upward (Y+) → CCW rotation → (-uy, ux)
+    let (perp_x, perp_y) = if blocker_above {
+        (uy, -ux) // CW rotation
+    } else {
+        (-uy, ux) // CCW rotation
+    };
+
+    let waypoint_x = ball_x + perp_x * WAYPOINT_OFFSET;
+    let waypoint_y = ball_y + perp_y * WAYPOINT_OFFSET;
+
+    Some(PlayerIntent::MoveToPosition {
+        target_x: waypoint_x,
+        target_y: waypoint_y,
+    })
+}
