+// ---------------------------------------------------------------------------
+// FUN-TS3: geometry-aware pass target selection
+// ---------------------------------------------------------------------------
+
+// Q32 constants for pos_to_zone (precomputed to avoid float arithmetic).
+// Pitch x: [-52.5, +52.5]m, 16 bins → bin_width = 105/16 = 6.5625m.
+// Zone_x = (pos_x + 52.5) / 6.5625; clamped to [0, 15].
+// 52.5 in Q32.32 = 52.5 × 2^32 = 225_485_783_040 raw bits (rounded).
+// 6.5625 in Q32.32 = 6.5625 × 2^32 = 28_180_722_893 raw bits (rounded).
+const PITCH_HALF_X_Q32: Q32 = Q32::from_raw(225_485_783_040_i64);
+const PITCH_ZONE_WIDTH_Q32: Q32 = Q32::from_raw(28_180_722_893_i64);
+
+// Pitch y: [-34, +34]m, 12 bins → bin_height = 68/12 ≈ 5.6667m.
+// 34.0 in Q32.32 = 34 × 2^32 = 146_028_888_064 raw bits.
+// 68/12 = 5.6667 in Q32.32 = 5.6667 × 2^32 ≈ 24_345_110_527 raw bits.
+const PITCH_HALF_Y_Q32: Q32 = Q32::from_raw(146_028_888_064_i64);
+const PITCH_ZONE_HEIGHT_Q32: Q32 = Q32::from_raw(24_345_110_527_i64);
+
+/// Weights for the `best_pass_target` scoring function (SOFT — TS3 drama-sweep).
+/// W_PC: attacker-control weight. W_XT: xT-gain weight.
+/// xT dominates so the ball progresses toward goal; attacker_control provides a
+/// safety floor so severely-pressed zones are still penalised.
+/// Prior W_PC=0.60/W_XT=0.40 proved too safety-biased: passes cycled in midfield
+/// with attacker_control in the safe backward zone always outscoring the contested
+/// forward zone, producing 0 shots across full matches.
+const W_PC: Q32 = Q32::from_raw(1_717_986_918_i64); // ≈ 0.40
+const W_XT: Q32 = Q32::from_raw(2_576_980_378_i64); // ≈ 0.60
+
+/// xT neutral offset: shifts the xT range so backward passes (negative xT) still
+/// have positive score from the attacker_control term. Value: 0.10 in Q32.
+/// Backward passes get W_XT × (xt_gain + 0.10); central-xT ≈ 0 → score ≈ 0.04.
+const XT_NEUTRAL: Q32 = Q32::from_raw(429_496_730_i64); // ≈ 0.10
+
+/// Distance filter thresholds for kind-specific candidate filtering.
+/// Short passes skip candidates beyond 30m (raised from blueprint's 20m to
+/// accommodate the 55m attacking compactness_h — wing players are ~27m from
+/// centre in the wide attacking shape, which would exclude them from a 20m filter).
+/// Long passes skip candidates within 15m of passer.
+const SHORT_PASS_MAX_DIST_SQ: Q32 = Q32::from_raw((30_i64 * 30_i64) << 32); // 900 m² (30m threshold)
+const LONG_PASS_MIN_DIST_SQ: Q32 = Q32::from_raw((15_i64 * 15_i64) << 32); // 225 m² (15m²)
+
+/// Cross pass: box-area filter x threshold. In Q32: 35m. For home attacks (+x),
+/// only consider candidates with pos_x > +35m; away: pos_x < -35m.
+const CROSS_BOX_X_Q32: Q32 = Q32::from_raw(35_i64 << 32); // 35.0m
+
+/// Convert pitch coordinates to a `PitchZone` for the xT grid lookup.
+///
+/// Grid convention (per `xt.rs`): x=0 = own-goal end, x=15 = attacking-goal-line.
+/// For HOME team (attacks +x, own goal at -52.5m): raw zone_x = (pos_x + 52.5) / 6.5625,
+/// clamped to [0, 15]. For AWAY team (attacks -x): mirror x → 15 - home_zone_x.
+/// Zone y is team-independent: y=0 = bottom touchline, y=11 = top.
+///
+/// All arithmetic is Q32 — no floats in canonical paths. The result is always
+/// in range because the clamping is explicit.
+fn pos_to_zone(pos_x: Q32, pos_y: Q32, team_idx: usize) -> crate::utility::xt::PitchZone {
+    // Home-team zone_x: (pos_x + 52.5m) / 6.5625m → [0, 16) → clamp to [0, 15].
+    // Using i64 raw-bit arithmetic to stay in Q32 semantics.
+    let shifted_x = pos_x + PITCH_HALF_X_Q32;
+    let zone_x_q32 = shifted_x / PITCH_ZONE_WIDTH_Q32;
+    // Clamp: zone_x is in [0, 15]; negative or >15 would be out-of-pitch.
+    let zone_x_raw = zone_x_q32.to_bits();
+    let zone_x_home: u8 = if zone_x_raw < 0 {
+        0u8
+    } else if zone_x_raw >= (16_i64 << 32) {
+        15u8
+    } else {
+        // Integer part: upper bits of Q32.32 (right-shift 32).
+        (zone_x_raw >> 32).clamp(0, 15) as u8
+    };
+
+    // Away team mirrors x.
+    let zone_x: u8 = if team_idx == 0 {
+        zone_x_home
+    } else {
+        15 - zone_x_home
+    };
+
+    // Zone y: (pos_y + 34m) / (68/12)m → [0, 12) → clamp to [0, 11].
+    let shifted_y = pos_y + PITCH_HALF_Y_Q32;
+    let zone_y_q32 = shifted_y / PITCH_ZONE_HEIGHT_Q32;
+    let zone_y_raw = zone_y_q32.to_bits();
+    let zone_y: u8 = if zone_y_raw < 0 {
+        0u8
+    } else if zone_y_raw >= (12_i64 << 32) {
+        11u8
+    } else {
+        (zone_y_raw >> 32).clamp(0, 11) as u8
+    };
+
+    // SAFETY: zone_x ∈ [0, 15], zone_y ∈ [0, 11] — both within PitchZone bounds.
+    crate::utility::xt::PitchZone::new(zone_x, zone_y)
+        .expect("pos_to_zone: zone coords out of range after explicit clamp — invariant violated")
+}
+
+/// Proximity weight for the target-direction term in `best_pass_target`.
+/// W_TGT: candidates closer to the intent's directional target score higher.
+/// This preserves the BT's directional intent (e.g. Long pass at x=+25m biases
+/// toward players near that point) so the ball advances toward the attacking third.
+const W_TGT: Q32 = Q32::from_raw(1_288_490_189_i64); // ≈ 0.30
+
+/// Max distance for the proximity-to-target normalisation (metres).
+/// A candidate at target_pos scores 1.0; a candidate 50m away scores ~0.0.
+const TARGET_PROX_MAX_DIST: Q32 = Q32::from_raw(50_i64 << 32); // 50.0m
+
+/// FUN-TS3: geometry-aware pass target selection.
+///
+/// Replaces `nearest_teammate_near` at the four outfield pass-class arms.
+/// Scores each same-team candidate by:
+///   `W_PC × attacker_control(candidate_pos)
+///    + W_XT × clamp(xt_gain + XT_NEUTRAL, 0, 1)
+///    + W_TGT × proximity_to_target`
+///
+/// The attacker_control term keeps passes safe under pressure; the xT term biases
+/// toward progressive when open; the target proximity term preserves the BT's
+/// directional intent (Long to x=+25m routes toward that area, not just safe midfield).
+///
+/// Kind filters:
+/// - `Long`: skip candidates within 15m.
+/// - `Short`: skip candidates beyond 30m.
+/// - `LayOff`: only backward/lateral candidates.
+/// - `Cross`: only box-area candidates (fallback: filter-free if none in box).
+///
+/// Returns the slot of the best candidate. Slot-order tiebreak for determinism.
+/// Panics (assert!) if the selection would produce a self-pass — a canonical invariant.
+fn best_pass_target(
+    state: &MatchState,
+    from_slot_idx: usize,
+    kind: PassKind,
+    target_x: Q32,
+    target_y: Q32,
+) -> u8 {
+    use crate::pass_completion::build_team_snapshots;
+    use crate::utility::pitch_control::pitch_control;
+    use crate::utility::xt::xt_delta;
+
+    let (attackers, defenders) = build_team_snapshots(state, from_slot_idx);
+    let passer = &state.players[from_slot_idx];
+    let passer_slot = passer.slot;
+    let passer_is_home = (from_slot_idx) < crate::PLAYERS_PER_TEAM;
+    let team_idx = if passer_is_home { 0usize } else { 1usize };
+
+    let passer_zone = pos_to_zone(passer.pos_x, passer.pos_y, team_idx);
+    let passer_x = passer.pos_x;
+
+    let team_start = team_idx * crate::PLAYERS_PER_TEAM;
+    let team_end = team_start + crate::PLAYERS_PER_TEAM;
+    // GK is always the first slot in each team (slot index = team_start).
+    let gk_slot_idx = team_start;
+
+    let mut best_slot = passer_slot;
+    // Use Q32::MIN analog: -2^63. Track best score across candidates.
+    let mut best_score: Q32 = Q32::from_raw(i64::MIN);
+
+    for candidate_idx in team_start..team_end {
+        if candidate_idx == from_slot_idx {
+            continue;
+        }
+        // Exclude GK from Short/Long/Cross passes in outfield play.
+        // The GK almost never needs to receive a field pass: their high
+        // attacker_control in their own penalty area dominates the score and
+        // directs Long passes backward into the GK zone — creating a stall.
+        // LayOff to GK is allowed (emergency back-pass).
+        // GK distribution (GkDistributeShort/Long) uses nearest_teammate_near,
+        // not best_pass_target, so GK-as-passer is already handled separately.
+        if candidate_idx == gk_slot_idx && kind != PassKind::LayOff {
+            continue;
+        }
+        let candidate = &state.players[candidate_idx];
+        let cand_x = candidate.pos_x;
+        let cand_y = candidate.pos_y;
+        let cand_slot = candidate.slot;
+
+        // Kind-specific filters.
+        match kind {
+            PassKind::Short => {
+                // Skip candidates beyond 20m from passer.
+                let dx = cand_x - passer_x;
+                let dy = cand_y - passer.pos_y;
+                let dist_sq = dx * dx + dy * dy;
+                if dist_sq > SHORT_PASS_MAX_DIST_SQ {
+                    continue;
+                }
+            }
+            PassKind::Long => {
+                // Skip candidates within 15m from passer.
+                let dx = cand_x - passer_x;
+                let dy = cand_y - passer.pos_y;
+                let dist_sq = dx * dx + dy * dy;
+                if dist_sq < LONG_PASS_MIN_DIST_SQ {
+                    continue;
+                }
+            }
+            PassKind::LayOff => {
+                // Only backward/lateral: passer_x ≥ cand_x for home; ≤ for away.
+                if passer_is_home {
+                    if cand_x > passer_x {
+                        continue;
+                    }
+                } else if cand_x < passer_x {
+                    continue;
+                }
+            }
+            PassKind::Cross => {
+                // Only box-area: cand_x > +35m for home; < -35m for away.
+                if passer_is_home {
+                    if cand_x <= CROSS_BOX_X_Q32 {
+                        continue;
+                    }
+                } else if cand_x >= -CROSS_BOX_X_Q32 {
+                    continue;
+                }
+            }
+        }
+
+        // Attacker control at candidate position.
+        let ctrl_outcome = pitch_control((cand_x, cand_y), &attackers, &defenders);
+        let attacker_ctrl = ctrl_outcome.attacker_control;
+
+        // xT gain from passer zone to candidate zone.
+        let cand_zone = pos_to_zone(cand_x, cand_y, team_idx);
+        let xt_gain = xt_delta(passer_zone, cand_zone);
+
+        // Adjusted xT: shift by XT_NEUTRAL so backward passes still have positive
+        // adjusted_xt — a back-pass to retain possession has positive score from
+        // the attacker_control term.
+        let adjusted_xt = xt_gain + XT_NEUTRAL;
+        let adjusted_xt_clamped = if adjusted_xt < Q32::ZERO {
+            Q32::ZERO
+        } else if adjusted_xt > Q32::ONE {
+            Q32::ONE
+        } else {
+            adjusted_xt
+        };
+
+        // Proximity-to-intent-target: how close the candidate is to the BT's
+        // intended direction (e.g. Long at x=+25m should route toward +25m, not
+        // just the safest midfield player). Linear decay: 1.0 at target, 0.0 at 50m+.
+        let dx_tgt = (cand_x - target_x).to_bits().unsigned_abs();
+        let dy_tgt = (cand_y - target_y).to_bits().unsigned_abs();
+        let manhattan_raw = (dx_tgt as i128 + dy_tgt as i128).min(i64::MAX as i128) as i64;
+        let manhattan = Q32::from_raw(manhattan_raw);
+        let prox_raw = Q32::ONE - manhattan / TARGET_PROX_MAX_DIST;
+        let proximity = if prox_raw < Q32::ZERO {
+            Q32::ZERO
+        } else {
+            prox_raw
+        };
+
+        let score = W_PC * attacker_ctrl + W_XT * adjusted_xt_clamped + W_TGT * proximity;
+
+        // Slot-order tiebreak: strictly greater-than so lower slots win ties.
+        if best_slot == passer_slot || score > best_score {
+            best_score = score;
+            best_slot = cand_slot;
+        }
+    }
+
+    // Fallback: if no candidate passed the kind filter (e.g. Cross with no
+    // box-area candidates at match start, LayOff when all teammates are forward),
+    // run the filter-free scoring loop across ALL same-team players to find the
+    // best scoring candidate without the kind constraint. This ensures the pass
+    // goes to the most-open progressive target rather than the nearest-to-passer
+    // (which would cause circular ping-pong when two adjacent players are chosen
+    // repeatedly because neither reaches the box threshold for Cross).
+    if best_slot == passer_slot {
+        let mut fallback_best_slot = passer_slot;
+        let mut fallback_best_score = Q32::from_raw(i64::MIN);
+
+        // Reuse the attacker/defender snapshots built at the top of this function.
+
+        let gk_slot_idx = team_start; // GK is always the first slot in each team.
+        for candidate_idx in team_start..team_end {
+            if candidate_idx == from_slot_idx {
+                continue;
+            }
+            // Exclude GK from the fallback: GK is almost never a useful cross or
+            // advanced-pass target, and has very high attacker_control in their own
+            // penalty area which would otherwise dominate the score.
+            if candidate_idx == gk_slot_idx {
+                continue;
+            }
+            let candidate = &state.players[candidate_idx];
+            let cand_x = candidate.pos_x;
+            let cand_y = candidate.pos_y;
+            let cand_slot = candidate.slot;
+
+            let ctrl_outcome = pitch_control((cand_x, cand_y), &attackers, &defenders);
+            let attacker_ctrl = ctrl_outcome.attacker_control;
+            let cand_zone = pos_to_zone(cand_x, cand_y, team_idx);
+            let xt_gain = xt_delta(passer_zone, cand_zone);
+            let adjusted_xt = xt_gain + XT_NEUTRAL;
+            let adjusted_xt_clamped = if adjusted_xt < Q32::ZERO {
+                Q32::ZERO
+            } else if adjusted_xt > Q32::ONE {
+                Q32::ONE
+            } else {
+                adjusted_xt
+            };
+            let dx_tgt = (cand_x - target_x).to_bits().unsigned_abs();
+            let dy_tgt = (cand_y - target_y).to_bits().unsigned_abs();
+            let manhattan_raw = (dx_tgt as i128 + dy_tgt as i128).min(i64::MAX as i128) as i64;
+            let manhattan = Q32::from_raw(manhattan_raw);
+            let prox_raw = Q32::ONE - manhattan / TARGET_PROX_MAX_DIST;
+            let proximity = if prox_raw < Q32::ZERO {
+                Q32::ZERO
+            } else {
+                prox_raw
+            };
+            let score = W_PC * attacker_ctrl + W_XT * adjusted_xt_clamped + W_TGT * proximity;
+
+            if fallback_best_slot == passer_slot || score > fallback_best_score {
+                fallback_best_score = score;
+                fallback_best_slot = cand_slot;
+            }
+        }
+
+        best_slot = if fallback_best_slot == passer_slot {
+            // Absolute last resort: nearest teammate (guarantees no self-pass).
+            nearest_teammate_near(state, from_slot_idx, passer.pos_x, passer.pos_y)
+        } else {
+            fallback_best_slot
+        };
+    }
+
+    // Canonical invariant: self-pass must never land in match_events.
+    // assert! fires in both debug and release (Sim/RULES.md §11).
+    assert_ne!(
+        best_slot, passer_slot,
+        "best_pass_target produced a self-pass for slot_idx={from_slot_idx} \
+         (kind={kind:?}); loop did not find any teammate — check team-boundary derivation"
+    );
+
+    best_slot
+}
+
