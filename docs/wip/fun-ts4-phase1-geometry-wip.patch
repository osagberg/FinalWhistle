+// ---------------------------------------------------------------------------
+// FUN-TS4 Phase 1: geometry-aware pass target selection (best_pass_target)
+// ---------------------------------------------------------------------------
+
+// Q32 constants for pos_to_zone (x-axis).
+// Pitch x: [-52.5, +52.5]m, 16 bins → bin_width = 105/16 = 6.5625m.
+// 52.5 in Q32.32 = 52.5 × 2^32 = 225_485_783_040 raw bits.
+// 6.5625 × 2^32 = 28_185_722_880 (FUN-TS3b Fix B corrected value).
+const BPT_PITCH_HALF_X_Q32: Q32 = Q32::from_raw(225_485_783_040_i64);
+const BPT_PITCH_ZONE_WIDTH_Q32: Q32 = Q32::from_raw(28_185_722_880_i64);
+
+// Q32 constants for pos_to_zone (y-axis).
+// Pitch y: [-34, +34]m, 12 bins → bin_height = 68/12 ≈ 5.6667m.
+// 34.0 × 2^32 = 146_028_888_064.
+// 5.6667 × 2^32 ≈ 24_345_110_527.
+const BPT_PITCH_HALF_Y_Q32: Q32 = Q32::from_raw(146_028_888_064_i64);
+const BPT_PITCH_ZONE_HEIGHT_Q32: Q32 = Q32::from_raw(24_345_110_527_i64);
+
+/// Scoring weights for `best_pass_target`.
+/// W_PC: attacker-control (safety). W_XT: xT-gain (progression).
+/// W_TGT: proximity-to-intent-target (direction preservation).
+/// Spec (FUN-TS4 blueprint §Phase 1): W_PC=0.55, W_XT=0.35, W_TGT=0.10.
+/// Short-dominated-mix tuning: safety-biased so midfield recycling stays safe
+/// while still biasing toward progressive zones when open.
+const W_PC: Q32 = Q32::from_raw(2_362_232_012_i64); // ≈ 0.55
+const W_XT: Q32 = Q32::from_raw(1_503_238_554_i64); // ≈ 0.35
+const W_TGT: Q32 = Q32::from_raw(429_496_730_i64); // ≈ 0.10
+
+/// xT neutral offset: backward passes get shifted xT so they still have a
+/// positive contribution when attacker_control is high. Value: 0.10.
+const XT_NEUTRAL: Q32 = Q32::from_raw(429_496_730_i64); // ≈ 0.10
+
+/// Short pass max distance² filter (30m threshold). Raised from blueprint 20m
+/// to accommodate the 44m attacking compactness_h — wing players sit ~22m from
+/// centre, so a 20m radius would exclude them from short-pass selection.
+const SHORT_PASS_MAX_DIST_SQ: Q32 = Q32::from_raw((30_i64 * 30_i64) << 32); // 900 m²
+
+/// Long pass min distance² filter (15m threshold). Candidates within 15m of
+/// the passer are excluded from long-pass selection (those are short-pass range).
+const LONG_PASS_MIN_DIST_SQ: Q32 = Q32::from_raw((15_i64 * 15_i64) << 32); // 225 m²
+
+/// Cross box-area x threshold: 35m from centre. For home (attacks +x), only
+/// candidates with pos_x > +35m qualify; away mirrors to pos_x < -35m.
+const CROSS_BOX_X_Q32: Q32 = Q32::from_raw(35_i64 << 32); // 35.0m
+
+/// Max Manhattan distance for proximity-to-target normalisation.
+/// A candidate at the intent's target point scores 1.0; 50m+ scores 0.0.
+const TARGET_PROX_MAX_DIST: Q32 = Q32::from_raw(50_i64 << 32); // 50.0m
+
+/// Convert pitch coordinates to a `PitchZone` for xT grid lookup.
+///
+/// Grid convention (per `xt.rs`): x=0 = own-goal end, x=15 = attacking-goal-line.
+/// For HOME team (attacks +x, own goal at -52.5m): zone_x = floor((pos_x + 52.5) / 6.5625).
+/// For AWAY team (attacks -x): mirror x = 15 - home_zone_x.
+/// Zone y is team-independent: y=0 = bottom touchline, y=11 = top.
+/// All arithmetic is Q32 — no floats in canonical paths.
+fn pos_to_zone(pos_x: Q32, pos_y: Q32, team_idx: usize) -> crate::utility::xt::PitchZone {
+    let shifted_x = pos_x + BPT_PITCH_HALF_X_Q32;
+    let zone_x_q32 = shifted_x / BPT_PITCH_ZONE_WIDTH_Q32;
+    let zone_x_raw = zone_x_q32.to_bits();
+    let zone_x_home: u8 = if zone_x_raw < 0 {
+        0u8
+    } else if zone_x_raw >= (16_i64 << 32) {
+        15u8
+    } else {
+        (zone_x_raw >> 32).clamp(0, 15) as u8
+    };
+    let zone_x: u8 = if team_idx == 0 {
+        zone_x_home
+    } else {
+        15 - zone_x_home
+    };
+
+    let shifted_y = pos_y + BPT_PITCH_HALF_Y_Q32;
+    let zone_y_q32 = shifted_y / BPT_PITCH_ZONE_HEIGHT_Q32;
+    let zone_y_raw = zone_y_q32.to_bits();
+    let zone_y: u8 = if zone_y_raw < 0 {
+        0u8
+    } else if zone_y_raw >= (12_i64 << 32) {
+        11u8
+    } else {
+        (zone_y_raw >> 32).clamp(0, 11) as u8
+    };
+
+    // SAFETY: zone_x ∈ [0, 15], zone_y ∈ [0, 11] — both within PitchZone bounds.
+    crate::utility::xt::PitchZone::new(zone_x, zone_y)
+        .expect("pos_to_zone: zone coords out of range after explicit clamp — invariant violated")
+}
+
+/// FUN-TS4 Phase 1: geometry-aware pass target selection.
+///
+/// Replaces `nearest_teammate_near` at the four outfield pass-class arms.
+/// Scores each same-team candidate (excluding the passer) by:
+///   `W_PC × attacker_control(candidate_pos)
+///    + W_XT × clamp(xt_gain + XT_NEUTRAL, 0, 1)
+///    + W_TGT × proximity_to_intent_target`
+///
+/// Kind filters applied before scoring:
+/// - `Short`: skip candidates > 30m from passer (dist²).
+/// - `Long`: skip candidates < 15m from passer (dist²).
+/// - `LayOff`: only backward/lateral candidates (cand_x ≤ passer_x for home).
+/// - `Cross`: only box-area candidates (cand_x > 35m for home); fallback to
+///   filter-free scoring when no box-area candidates exist.
+///
+/// GK is excluded from Short/Long/Cross selection (but allowed for LayOff).
+/// Fallback when no candidate passes the filter: filter-free scoring across all
+/// non-GK teammates (guarantees no self-pass).
+/// Slot-order tiebreak for determinism (lower slot wins ties).
+/// Panics (assert!) on self-pass — canonical invariant per Sim/RULES.md §11.
+fn best_pass_target(
+    state: &MatchState,
+    from_slot_idx: usize,
+    kind: PassKind,
+    target_x: Q32,
+    target_y: Q32,
+) -> u8 {
+    use crate::pass_completion::build_team_snapshots;
+    use crate::utility::pitch_control::pitch_control;
+    use crate::utility::xt::xt_delta;
+
+    let (attackers, defenders) = build_team_snapshots(state, from_slot_idx);
+    let passer = &state.players[from_slot_idx];
+    let passer_slot = passer.slot;
+    let passer_is_home = from_slot_idx < crate::PLAYERS_PER_TEAM;
+    let team_idx: usize = if passer_is_home { 0 } else { 1 };
+    let passer_x = passer.pos_x;
+    let passer_y = passer.pos_y;
+
+    let passer_zone = pos_to_zone(passer_x, passer_y, team_idx);
+
+    let team_start = team_idx * crate::PLAYERS_PER_TEAM;
+    let team_end = team_start + crate::PLAYERS_PER_TEAM;
+    let gk_slot_idx = team_start; // GK is always the first slot in each team.
+
+    let mut best_slot = passer_slot; // sentinel: "not found yet"
+    let mut best_score: Q32 = Q32::from_raw(i64::MIN);
+
+    for candidate_idx in team_start..team_end {
+        if candidate_idx == from_slot_idx {
+            continue;
+        }
+        // GK excluded from Short/Long/Cross — their high attacker_control in
+        // own penalty area dominates and directs passes backward into the GK
+        // zone, stalling build-up. LayOff to GK is allowed (emergency back-pass).
+        if candidate_idx == gk_slot_idx && kind != PassKind::LayOff {
+            continue;
+        }
+
+        let candidate = &state.players[candidate_idx];
+        let cand_x = candidate.pos_x;
+        let cand_y = candidate.pos_y;
+        let cand_slot = candidate.slot;
+
+        // Kind-specific distance/position filter.
+        match kind {
+            PassKind::Short => {
+                let dx = cand_x - passer_x;
+                let dy = cand_y - passer_y;
+                let dist_sq = dx * dx + dy * dy;
+                if dist_sq > SHORT_PASS_MAX_DIST_SQ {
+                    continue;
+                }
+            }
+            PassKind::Long => {
+                let dx = cand_x - passer_x;
+                let dy = cand_y - passer_y;
+                let dist_sq = dx * dx + dy * dy;
+                if dist_sq < LONG_PASS_MIN_DIST_SQ {
+                    continue;
+                }
+            }
+            PassKind::LayOff => {
+                // Backward or lateral only.
+                if passer_is_home {
+                    if cand_x > passer_x {
+                        continue;
+                    }
+                } else if cand_x < passer_x {
+                    continue;
+                }
+            }
+            PassKind::Cross => {
+                // Box-area only.
+                if passer_is_home {
+                    if cand_x <= CROSS_BOX_X_Q32 {
+                        continue;
+                    }
+                } else if cand_x >= -CROSS_BOX_X_Q32 {
+                    continue;
+                }
+            }
+        }
+
+        let ctrl_outcome = pitch_control((cand_x, cand_y), &attackers, &defenders);
+        let attacker_ctrl = ctrl_outcome.attacker_control;
+
+        let cand_zone = pos_to_zone(cand_x, cand_y, team_idx);
+        let xt_gain = xt_delta(passer_zone, cand_zone);
+        let adjusted_xt = xt_gain + XT_NEUTRAL;
+        let adjusted_xt_clamped = if adjusted_xt < Q32::ZERO {
+            Q32::ZERO
+        } else if adjusted_xt > Q32::ONE {
+            Q32::ONE
+        } else {
+            adjusted_xt
+        };
+
+        // Proximity to intent target: linear decay from 1.0 at target to 0.0 at 50m.
+        let dx_tgt = (cand_x - target_x).to_bits().unsigned_abs();
+        let dy_tgt = (cand_y - target_y).to_bits().unsigned_abs();
+        let manhattan_raw = (dx_tgt as i128 + dy_tgt as i128).min(i64::MAX as i128) as i64;
+        let manhattan = Q32::from_raw(manhattan_raw);
+        let prox_raw = Q32::ONE - manhattan / TARGET_PROX_MAX_DIST;
+        let proximity = if prox_raw < Q32::ZERO {
+            Q32::ZERO
+        } else {
+            prox_raw
+        };
+
+        let score = W_PC * attacker_ctrl + W_XT * adjusted_xt_clamped + W_TGT * proximity;
+
+        // Slot-order tiebreak: strictly-greater so lower slot indices win ties.
+        if best_slot == passer_slot || score > best_score {
+            best_score = score;
+            best_slot = cand_slot;
+        }
+    }
+
+    // Fallback: no candidate passed the kind filter (e.g. Cross with no box-area
+    // candidates early in the match). Run filter-free scoring across all non-GK
+    // teammates. This ensures progressive routing rather than ping-pong on the
+    // nearest-2 players when neither is in the box.
+    if best_slot == passer_slot {
+        let mut fb_best_slot = passer_slot;
+        let mut fb_best_score: Q32 = Q32::from_raw(i64::MIN);
+
+        for candidate_idx in team_start..team_end {
+            if candidate_idx == from_slot_idx || candidate_idx == gk_slot_idx {
+                continue;
+            }
+            let candidate = &state.players[candidate_idx];
+            let cand_x = candidate.pos_x;
+            let cand_y = candidate.pos_y;
+            let cand_slot = candidate.slot;
+
+            let ctrl_outcome = pitch_control((cand_x, cand_y), &attackers, &defenders);
+            let attacker_ctrl = ctrl_outcome.attacker_control;
+            let cand_zone = pos_to_zone(cand_x, cand_y, team_idx);
+            let xt_gain = xt_delta(passer_zone, cand_zone);
+            let adjusted_xt = xt_gain + XT_NEUTRAL;
+            let adjusted_xt_clamped = if adjusted_xt < Q32::ZERO {
+                Q32::ZERO
+            } else if adjusted_xt > Q32::ONE {
+                Q32::ONE
+            } else {
+                adjusted_xt
+            };
+            let dx_tgt = (cand_x - target_x).to_bits().unsigned_abs();
+            let dy_tgt = (cand_y - target_y).to_bits().unsigned_abs();
+            let manhattan_raw = (dx_tgt as i128 + dy_tgt as i128).min(i64::MAX as i128) as i64;
+            let manhattan = Q32::from_raw(manhattan_raw);
+            let prox_raw = Q32::ONE - manhattan / TARGET_PROX_MAX_DIST;
+            let proximity = if prox_raw < Q32::ZERO {
+                Q32::ZERO
+            } else {
+                prox_raw
+            };
+            let score = W_PC * attacker_ctrl + W_XT * adjusted_xt_clamped + W_TGT * proximity;
+
+            if fb_best_slot == passer_slot || score > fb_best_score {
+                fb_best_score = score;
+                fb_best_slot = cand_slot;
+            }
+        }
+
+        best_slot = if fb_best_slot == passer_slot {
+            // Absolute last resort: nearest teammate (guarantees no self-pass).
+            nearest_teammate_near(state, from_slot_idx, passer_x, passer_y)
+        } else {
+            fb_best_slot
+        };
+    }
+
+    // Canonical invariant: self-pass must never appear in match_events.
+    // assert! fires in both debug and release (Sim/RULES.md §11).
+    assert_ne!(
+        best_slot, passer_slot,
+        "best_pass_target produced a self-pass for slot_idx={from_slot_idx} \
+         (kind={kind:?}); loop found no teammate — check team-boundary derivation"
+    );
+
+    best_slot
+}
